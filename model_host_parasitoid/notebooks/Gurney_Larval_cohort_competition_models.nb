Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Tau]plus", " ", "=", " ", 
   RowBox[{
    FractionBox["n", "d1B"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[ExponentialE]", "^", 
       RowBox[{"(", 
        FractionBox["\[Eta]B", "n"], ")"}]}], "-", "1"}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Tau]\[Omega]", " ", "=", " ", 
   RowBox[{
    FractionBox["n", "d1B"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[ExponentialE]", "^", 
       RowBox[{"(", 
        FractionBox[
         RowBox[{"\[Eta]B", "-", "2"}], "n"], ")"}]}], "-", "1"}], ")"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.957256915209383*^9, 3.957256959623763*^9}, {
  3.957257072395651*^9, 3.957257144751286*^9}, {3.957257263441811*^9, 
