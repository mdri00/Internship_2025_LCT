4c3c898fc589"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tMin", " ", "=", " ", "800"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tMax", " ", "=", " ", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tH2test", " ", "=", " ", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tP1test", "  ", "=", " ", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"paramstest", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"mH", "->", "1"}], ",", 
    RowBox[{"\[Rho]", " ", "->", " ", "33"}], ",", 
    RowBox[{"\[Delta]H1", "->", "0"}], ",", 
    RowBox[{"\[Delta]H2", "->", 
     RowBox[{"1", "/", "tH2test"}]}], ",", " ", 
    RowBox[{"mP", "->", 
     RowBox[{"1", "/", "tP1test"}]}], ",", 
    RowBox[{"\[Delta]P2", "->", "8"}], ",", " ", 
    RowBox[{"\[Delta]P1", " ", "->", " ", "1"}], ",", " ", 
    RowBox[{"a", "->", " ", "1"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nn", " ", "=", " ", "20"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mm", " ", "=", " ", "20"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"H1", "[", "t", "]"}], "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "nn"], 
    RowBox[{
     RowBox[{"H", "[", "i", "]"}], "[", "t", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"P1", "[", "t", "]"}], "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "mm"], 
    RowBox[{
     RowBox[{"P", "[", "i", "]"}], "[", "t", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"H", "[", "i", "]"}], "[", "t", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nn"}], "}"}]}], "]"}], ",", 
      RowBox[{"H2", "[", "t", "]"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"P", "[", "i", "]"}], "[", "t", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "mm"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"P2", "[", "t", "]"}]}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"system", " ", "=", " ", 
   RowBox[{"ODEkSystem", "[", 
    RowBox[{"nn", ",", " ", "mm"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Theta]H", " ", "=", " ", 
   RowBox[{"n", "*", "mH"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Theta]P", " ", "=", " ", 
   RowBox[{"m", "*", "mP"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"r", " ", "=", " ", 
    RowBox[{"\[Rho]", "*", "\[Delta]H2"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"leqnIC", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{"{", 
     RowBox[{"system", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"H", "[", "1", "]"}], "[", "0", "]"}], " ", "==", " ", 
         "10"}], ",", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"H", "[", "i", "]"}], "[", "0", "]"}], " ", "==", " ", 
           "0"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "2", ",", "nn"}], "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"H2", "[", "0", "]"}], " ", "==", " ", "0"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"P", "[", "1", "]"}], "[", "0", "]"}], " ", "==", " ", 
         "10"}], ",", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"P", "[", "i", "]"}], "[", "0", "]"}], " ", "==", " ", 
           "0"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "2", ",", "mm"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"P2", "[", "0", "]"}], " ", "==", " ", "0"}]}], "}"}]}], 
     "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"leqnIC", "/.", "paramstest"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "->", "nn"}], ",", 
         RowBox[{"m", "->", "mm"}]}], "}"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"tH2", "->", "2"}], ",", " ", 
        RowBox[{"tP1", "->", "1"}]}], "}"}]}], ",", "vars", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", "tMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{
        RowBox[{"H2", "[", "t", "]"}], "/.", " ", 
