     "]"}]}], " ", ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ODEkSystem", "[", 
     RowBox[{"nn_", ",", " ", "mm_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"eqns", ",", "i"}], "}"}], ",", 
      RowBox[{
       RowBox[{"eqns", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"\[CapitalEAcute]quations", " ", "pour", " ", 
         RowBox[{"H", "[", "i", "]"}]}], "*)"}], 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"AppendTo", "[", 
          RowBox[{"eqns", ",", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"H", "[", "i", "]"}], "[", "t", "]"}], ",", "t"}], 
             "]"}], "==", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "\[Theta]H"}], "-", "\[Delta]H1", "-", 
                RowBox[{"a", " ", 
                 RowBox[{"P2", "[", "t", "]"}]}]}], ")"}], " ", 
              RowBox[{
               RowBox[{"H", "[", "i", "]"}], "[", "t", "]"}]}], "+", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"i", ">", "1"}], ",", 
               RowBox[{"\[Theta]H", " ", 
                RowBox[{
                 RowBox[{"H", "[", 
                  RowBox[{"i", "-", "1"}], "]"}], "[", "t", "]"}]}], ",", 
               RowBox[{"r", " ", 
                RowBox[{"H2", "[", "t", "]"}]}]}], "]"}]}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "nn"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"\[CapitalEAcute]quation", " ", "pour", " ", "H2"}], "*)"}], 
       RowBox[{"AppendTo", "[", 
        RowBox[{"eqns", ",", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"H2", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
          RowBox[{
           RowBox[{"\[Theta]H", " ", 
            RowBox[{
             RowBox[{"H", "[", "nn", "]"}], "[", "t", "]"}]}], "-", 
           RowBox[{"\[Delta]H2", " ", 
            RowBox[{"H2", "[", "t", "]"}]}]}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"\[CapitalEAcute]quations", " ", "pour", " ", 
         RowBox[{"P", "[", "i", "]"}]}], "*)"}], 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"AppendTo", "[", 
          RowBox[{"eqns", ",", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"P", "[", "i", "]"}], "[", "t", "]"}], ",", "t"}], 
             "]"}], "==", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "\[Theta]P"}], "-", "\[Delta]P1"}], ")"}], " ", 
              RowBox[{
               RowBox[{"P", "[", "i", "]"}], "[", "t", "]"}]}], "+", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"i", ">", "1"}], ",", 
               RowBox[{"\[Theta]P", " ", 
                RowBox[{
                 RowBox[{"P", "[", 
                  RowBox[{"i", "-", "1"}], "]"}], "[", "t", "]"}]}], ",", 
               RowBox[{"a", " ", 
                RowBox[{"P2", "[", "t", "]"}], " ", 
                RowBox[{"H1", "[", "t", "]"}]}]}], "]"}]}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "mm"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"\[CapitalEAcute]quation", " ", "pour", " ", "P2"}], "*)"}], 
       RowBox[{"AppendTo", "[", 
        RowBox[{"eqns", ",", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"P2", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
          RowBox[{
           RowBox[{"\[Theta]P", " ", 
            RowBox[{
             RowBox[{"P", "[", "nn", "]"}], "[", "t", "]"}]}], "-", 
           RowBox[{"\[Delta]P2", " ", 
            RowBox[{"P2", "[", "t", "]"}]}]}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", "eqns"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "analyze", " ", "a", " ", "single", " ", 
    "solution"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"analyzeSolutionfreq", "[", 
    RowBox[{"sol_", ",", "tMin_", ",", " ", "tMax_", ",", " ", 
     RowBox[{"step_", ":", ".2"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "lastValues", ",", "lastts", ",", " ", "mean", ",", "deviation", ",", 
       "min", ",", "max", ",", " ", "peaks", ",", " ", "nbpeaks", ",", " ", 
       "Tpeak"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"lastts", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{"t", ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "tMin", ",", " ", "tMax", ",", " ", "step"}],
           "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"lastValues", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"H2", "[", "t", "]"}], "/.", 
             RowBox[{"sol", " ", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], " ", "//", " ", "Evaluate"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "tMin", ",", "tMax", ",", "step"}], "}"}]}], 
          "]"}], ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"If", " ", 
         RowBox[{"there", "'"}], "s", " ", "oscillation"}], ",", 
        RowBox[{"return", " ", 
         RowBox[{"{", 
          RowBox[{"min", ",", "max"}], "}"}]}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"If", " ", "stable", " ", "equilibrium"}], ",", 
        RowBox[{"return", " ", 
         RowBox[{"{", 
          RowBox[{"equilibrium", ",", "equilibrium"}], "}"}]}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"mean", "=", 
       RowBox[{"Mean", "[", "lastValues", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"deviation", "=", 
       RowBox[{"StandardDeviation", "[", "lastValues", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"min", "=", 
       RowBox[{"Min", "[", "lastValues", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"max", "=", 
       RowBox[{"Max", "[", "lastValues", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Find", " ", "peaks"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"peaks", "=", 
       RowBox[{"FindPeaks", "[", 
        RowBox[{
        "lastValues", ",", "Automatic", ",", " ", "Automatic", ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"max", "-", "min"}], ")"}], "/", "4"}]}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"peak", " ", "higher", " ", "than", " ", "max"}], "-", 
         RowBox[{"min", "/", "4"}]}], " ", "->", " ", 
        RowBox[{"take", " ", "only", " ", "maxpeaks"}]}], "*)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "just", " ", "take", " ", "the", " ", "time", " ", "between", " ", 
        "two", " ", "arbitrary", " ", "chosen", " ", "peaks"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Tpeak", " ", "=", " ", 
       RowBox[{
        RowBox[{"lastts", "[", 
         RowBox[{"[", 
          RowBox[{"peaks", "[", 
           RowBox[{"[", 
            RowBox[{"4", ",", "1"}], "]"}], "]"}], "]"}], "]"}], "-", 
        RowBox[{"lastts", "[", 
         RowBox[{"[", 
          RowBox[{"peaks", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "If", " ", "std", " ", "dev", " ", "is", " ", "very", " ", "small"}], 
        ",", 
        RowBox[{
         RowBox[{"it", "'"}], "s", " ", "likely", " ", "a", " ", "stable", 
         " ", "equilibrium"}]}], "*)"}], 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"min", "<", "0"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "\"\<error\>\""}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"deviation", "<", "0.01"}], ",", 
          RowBox[{"{", 
           RowBox[{"mean", ",", "mean", ",", "\"\<equilibrium\>\""}], "}"}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
           "min", ",", "max", ",", "\"\<limit_cycle\>\"", ",", " ", "Tpeak"}],
            "}"}]}], "]"}]}], "]"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tH2par", "=", " ", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tP1par", " ", "=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
