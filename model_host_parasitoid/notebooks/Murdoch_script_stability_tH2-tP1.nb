Cell[BoxData[{
 RowBox[{"ClearAll", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DATADIR", " ", "=", " ", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{
      RowBox[{"ParentDirectory", "[", "]"}], ",", " ", "\"\</data/raw\>\""}], 
     "]"}]}], " ", ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CreateMatrix", "[", 
    RowBox[{"nn_", ",", " ", "mm_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"J", ",", "vars", ",", "i"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{"Variables", " ", "du", " ", "syst\[EGrave]me"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vars", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"H", "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "nn"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", "H2", "}"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"P", "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "mm"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", "P2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Initialiser", " ", "la", " ", "matrice", " ", "jacobienne", " ", 
        "avec", " ", "des", " ", "z\[EAcute]ros"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"J", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"nn", "+", "mm", "+", "2"}], ",", 
           RowBox[{"nn", "+", "mm", "+", "2"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Remplissage", " ", "de", " ", "la", " ", "sous"}], "-", 
        RowBox[{"matrice", " ", "pour", " ", 
         RowBox[{"H", "[", "i", "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"J", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"-", "\[Theta]H"}], "-", "\[Delta]H1", "-", 
           RowBox[{"a", " ", 
            RowBox[{"P2", "[", "t", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", ">", "1"}], ",", 
           RowBox[{
            RowBox[{"J", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", 
               RowBox[{"i", "-", "1"}]}], "]"}], "]"}], "=", "\[Theta]H"}]}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nn"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Remplissage", " ", "des", " ", "termes", " ", "de", " ", 
        "parasitisme"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"J", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", 
            RowBox[{"nn", "+", "mm", "+", "2"}]}], "]"}], "]"}], "=", 
         RowBox[{
          RowBox[{"-", "a"}], "*", 
          RowBox[{
           RowBox[{"H", "[", "i", "]"}], "[", "t", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nn"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Termes", " ", "li\[EAcute]s", " ", "\[AGrave]", " ", "H2"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"J", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", 
          RowBox[{"nn", "+", "1"}]}], "]"}], "]"}], "=", "r"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"H1", " ", "d\[EAcute]pend", " ", "de", " ", "H2"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"J", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"nn", "+", "1"}], ",", "nn"}], "]"}], "]"}], "=", 
       "\[Theta]H"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"H2", " ", "d\[EAcute]pend", " ", "de", " ", 
        RowBox[{"H", "[", "k", "]"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"J", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"nn", "+", "1"}], ",", 
          RowBox[{"nn", "+", "1"}]}], "]"}], "]"}], "=", 
       RowBox[{"-", "\[Delta]H2"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Remplissage", " ", "de", " ", "la", " ", "sous"}], "-", 
        RowBox[{"matrice", " ", "pour", " ", 
         RowBox[{"P", "[", "i", "]"}]}]}], "*)"}], 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"J", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"nn", "+", "1", "+", "i"}], ",", 
             RowBox[{"nn", "+", "1", "+", "i"}]}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"-", "\[Theta]P"}], "-", "\[Delta]P1"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", ">", "1"}], ",", 
           RowBox[{
            RowBox[{"J", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"nn", "+", "1", "+", "i"}], ",", 
               RowBox[{"nn", "+", "i"}]}], "]"}], "]"}], "=", "\[Theta]P"}]}],
           "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "mm"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Remplissage", " ", "des", " ", "termes", " ", "de", " ", 
        "parasitisme"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"J", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"nn", "+", "2"}], ",", "i"}], "]"}], "]"}], "=", 
         RowBox[{"a", "  ", 
          RowBox[{"P2", "[", "t", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nn"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"J", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"nn", "+", "2"}], ",", " ", 
          RowBox[{"nn", "+", "mm", "+", "2"}]}], "]"}], "]"}], " ", "=", " ", 
       
       RowBox[{"a", "*", 
        RowBox[{"H1", "[", "t", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Ligne", " ", "de", " ", "P2"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"J", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"nn", "+", "mm", "+", "2"}], ",", 
          RowBox[{"nn", "+", "mm", "+", "1"}]}], "]"}], "]"}], "=", 
       "\[Theta]P"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"J", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"nn", "+", "mm", "+", "2"}], ",", 
          RowBox[{"nn", "+", "mm", "+", "2"}]}], "]"}], "]"}], "=", 
       RowBox[{"-", "\[Delta]P2"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Retourner", " ", "la", " ", "matrice", " ", "jacobienne"}], 
       "*)"}], "\[IndentingNewLine]", "J"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.953621134528728*^9, 3.953621149832917*^9}, {
  3.959752883433169*^9, 3.959752883533085*^9}, {3.9597530914144077`*^9, 
