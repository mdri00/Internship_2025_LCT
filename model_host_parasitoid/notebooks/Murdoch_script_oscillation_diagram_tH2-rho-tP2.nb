              ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"a", " ", "fH"}], ")"}]}]}], " ", "//", " ", 
           "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"sH", " ", "=", " ", 
          RowBox[{"\[Theta]H", " ", "/", " ", 
           RowBox[{"(", 
            RowBox[{"\[Theta]H", " ", "+", " ", "\[Delta]H1", " ", "+", " ", 
             RowBox[{"a", " ", "P2eqpredi"}]}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"\[Alpha]H", " ", "=", " ", 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"i", "=", "0"}], 
            RowBox[{"n", "-", "1"}]], 
           RowBox[{
