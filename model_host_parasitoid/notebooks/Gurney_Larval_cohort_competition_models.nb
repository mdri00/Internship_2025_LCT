  RowBox[{"Clear", "[", 
   RowBox[{
   "aB", ",", " ", "bB", ",", " ", "dB", ",", " ", "d1B", ",", " ", "\[Eta]B",
     ",", " ", "\[Tau]B", ",", " ", "\[Tau]1B", ",", "n"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aBpar", " ", "=", " ", "7"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bBpar", " ", "=", " ", "350"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dBpar", " ", "=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d1Bpar", " ", "=", " ", "0.25"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Eta]Bpar", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Log", "[", 
      FractionBox["bB", "dB"], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"bB", "->", "bBpar"}], ",", " ", 
       RowBox[{"dB", "->", "dBpar"}]}], "}"}]}], " ", "//", "N"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"parBeretta", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"aB", "->", "aBpar"}], ",", " ", 
    RowBox[{"bB", "->", "bBpar"}], ",", " ", 
    RowBox[{"dB", " ", "->", " ", "dBpar"}], ",", " ", 
    RowBox[{"d1B", "->", "d1Bpar"}], ",", " ", 
    RowBox[{"\[Eta]B", "->", "\[Eta]Bpar"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"enB", "[", "z_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      FractionBox["z", "n"]}], ")"}], "^", "n"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.957256915209383*^9, 3.957256959623763*^9}, {
  3.957257072395651*^9, 3.957257144751286*^9}, {3.957257263441811*^9, 
