            "\"\<Highest VP\>\""}], "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Data", "=", 
          RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"H1", "[", "t", "]"}], "=", " ", 
