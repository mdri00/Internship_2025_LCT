Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"parQuentin", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Delta]j", " ", "->", " ", "0.07"}], ",", " ", 
     RowBox[{"A0", "->", "600"}], ",", " ", 
     RowBox[{"q", "->", "8.5"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"replacement", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "-", "pmort"}], " ", "==", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "\[Delta]j"}], " ", "\[Tau]1"}], "]"}]}], ",", 
       "\[Tau]1", ",", " ", "Reals"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "//", "Normal"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VPNonTriDDEreplaced", " ", "=", " ", 
   RowBox[{"VPNonTriDDE", " ", "/.", "replacement"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"s", "/.", "VPNonTriDDEreplaced"}], "/.", "parQuentin"}], " ", "//",
      "N"}], " ", "//", " ", "Re"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"\[Delta]a", ",", " ", "0.01", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
