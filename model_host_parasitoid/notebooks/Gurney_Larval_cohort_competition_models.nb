e3b96508765f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GenerateSystemLCT", "[", "nn_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eqns", ",", "i"}], "}"}], ",", 
     RowBox[{
      RowBox[{"eqns", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"\[CapitalEAcute]quations", " ", "pour", " ", 
        RowBox[{"J", "[", "i", "]"}]}], "*)"}], 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"eqns", ",", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"J", "[", "i", "]"}], "[", "t", "]"}], ",", "t"}], 
            "]"}], "==", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "\[Theta]"}], "-", "\[Delta]j"}], ")"}], " ", 
             RowBox[{
              RowBox[{"J", "[", "i", "]"}], "[", "t", "]"}]}], "+", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"i", ">", "1"}], ",", 
              RowBox[{"\[Theta]", " ", 
               RowBox[{
                RowBox[{"J", "[", 
                 RowBox[{"i", "-", "1"}], "]"}], "[", "t", "]"}]}], ",", 
              RowBox[{"q", " ", 
               RowBox[{"A", "[", "t", "]"}], " ", 
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"A", "[", "t", "]"}]}], "/", "A0"}], "]"}]}]}], 
             "]"}]}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nn"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"\[CapitalEAcute]quation", " ", "pour", " ", "A"}], "*)"}], 
      " ", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"eqns", ",", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"A", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
         RowBox[{
          RowBox[{"\[Theta]", " ", 
           RowBox[{
            RowBox[{"J", "[", "nn", "]"}], "[", "t", "]"}]}], "-", 
          RowBox[{"\[Delta]a", " ", 
           RowBox[{"A", "[", "t", "]"}]}]}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", "eqns"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.954830935166741*^9, 3.954831093511318*^9}, {
  3.954831124141823*^9, 3.954831125350307*^9}},
