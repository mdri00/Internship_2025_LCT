Cell[BoxData[{
 RowBox[{
  RowBox[{"qq", "=", "8.5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Delta]aq", "=", 
   RowBox[{"pts", "[", 
    RowBox[{"[", 
     RowBox[{"3", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
