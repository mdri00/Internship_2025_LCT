Cell[BoxData[{
 RowBox[{
  RowBox[{"klist", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Range", "[", "10", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"20", ",", "50", ",", "100", ",", " ", "10000"}], "}"}]}], 
     "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"curvelist", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ComputeCurvesFunction", "[", "kval_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"parPI", ",", "reel", ",", "imag", ",", 
        RowBox[{"xtempo", "=", "2.12"}], ",", 
        RowBox[{"tP1tempo", "=", "0.5"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"parPI", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Tau]1", "\[Rule]", "1"}], ",", 
          RowBox[{"\[Delta]H1", "\[Rule]", "0"}], ",", 
          RowBox[{"\[Delta]P1", "\[Rule]", "1"}], ",", 
          RowBox[{"a", "\[Rule]", "1"}], ",", 
          RowBox[{"\[Delta]P2", "\[Rule]", "8"}], ",", 
          RowBox[{"\[Rho]", "\[Rule]", "33"}], ",", 
          RowBox[{"k", "\[Rule]", "kval"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"reel", "=", 
        RowBox[{"ComplexExpand", "[", 
         RowBox[{"Re", "[", 
          RowBox[{
           RowBox[{"EqCaraPI", "/.", " ", 
            RowBox[{"{", 
             RowBox[{"s", "->", 
              RowBox[{"x", " ", "I"}]}], "}"}]}], "/.", " ", "parPI"}], "]"}],
          "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"imag", "=", 
        RowBox[{"ComplexExpand", "[", 
         RowBox[{"Im", "[", 
          RowBox[{
           RowBox[{"EqCaraPI", "/.", " ", 
            RowBox[{"{", 
             RowBox[{"s", "->", 
              RowBox[{"x", " ", "I"}]}], "}"}]}], "/.", " ", "parPI"}], "]"}],
          "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"FindtP1Stab", "[", "tH2_", "]"}], ":=", 
        RowBox[{"tP1", "/.", " ", 
         RowBox[{"FindRoot", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"reel", ",", "imag"}], "}"}], "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Delta]H2", "->", 
               RowBox[{"1", "/", "tH2"}]}], ",", 
              RowBox[{"\[Tau]2", "->", "tP1"}]}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "xtempo"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"tP1", ",", "tP1tempo"}], "}"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tH2val", ",", 
           RowBox[{"FindtP1Stab", "[", "tH2val", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"tH2val", ",", "0.05", ",", "5", ",", "0.05"}], "}"}]}], 
        "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Evaluate", " ", "for", " ", "each", " ", "kval", " ", "in", " ", 
    "klist"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"curvelist", "=", 
   RowBox[{"ComputeCurvesFunction", "/@", "klist"}]}], ";"}]}], "Input",
