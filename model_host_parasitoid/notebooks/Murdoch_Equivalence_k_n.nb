Cell[BoxData[{
 RowBox[{
  RowBox[{"P20temp", " ", "=", " ", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tratiotemp", " ", "=", " ", "0.3"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ktemp", " ", "=", " ", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"leqnIC", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{"{", 
     RowBox[{"systemePI", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"H1", "[", 
          RowBox[{"t", "/;", 
           RowBox[{"t", "<=", "0"}]}], "]"}], " ", "==", "10"}], ",", " ", 
        RowBox[{
         RowBox[{"H2", "[", 
          RowBox[{"t", "/;", 
           RowBox[{"t", "<=", "0"}]}], "]"}], " ", "==", "10"}], ",", " ", 
        RowBox[{
         RowBox[{"P1", "[", 
          RowBox[{"t", "/;", 
           RowBox[{"t", "<=", "0"}]}], "]"}], " ", "==", "10"}], ",", " ", 
        RowBox[{
         RowBox[{"P2", "[", 
          RowBox[{"t", "/;", 
           RowBox[{"t", "<=", "0"}]}], "]"}], " ", "==", "10"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"B", "[", 
              RowBox[{"t", "/;", 
               RowBox[{"t", "<=", "0"}]}], "]"}], " ", "==", 
             RowBox[{"\[Tau]1", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"k", " ", 
                 RowBox[{"Log", "[", 
                  RowBox[{"1", "+", 
                   RowBox[{"a", " ", 
                    RowBox[{"P20temp", "/", "k"}]}]}], "]"}]}], "+", " ", 
                "\[Delta]H1"}], ")"}]}]}], "/.", "\[Tau]2replace"}], "/.", 
           "parPIbis"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"k", "->", "ktemp"}], ",", " ", 
            RowBox[{"tRatio", "->", "tratiotemp"}]}], "}"}]}], " ", "//", " ",
          "N"}]}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"leqnIC", "/.", "\[Tau]2replace"}], "/.", "parPIbis"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"k", "->", "ktemp"}], ",", " ", 
        RowBox[{"tRatio", "->", "tratiotemp"}]}], "}"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "H1", ",", " ", "H2", ",", " ", "P1", ",", " ", "P2", ",", "B"}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", "500"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
