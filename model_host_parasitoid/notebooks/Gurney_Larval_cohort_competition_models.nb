Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"qq", "=", "8.5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Delta]aq", "=", "0.8"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Delta]jq", "=", "0.07"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Tau]1q", "=", "80"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A0q", "=", "600"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"par", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"q", "->", "qq"}], ",", 
     RowBox[{"\[Delta]a", " ", "->", "\[Delta]aq"}], ",", " ", 
     RowBox[{"\[Delta]j", " ", "->", " ", "\[Delta]jq"}], ",", " ", 
     RowBox[{"\[Tau]1", "->", "\[Tau]1q"}], ",", " ", 
     RowBox[{"A0", "->", "A0q"}]}], "}"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"leqnIC", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"{", 
     RowBox[{"systemMin", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "A0q"}], "}"}]}], "}"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"leqnIC", "/.", " ", "par"}], ",", 
     RowBox[{"{", "A", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "1000"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"A", "[", "t", "]"}], "/.", " ", 
     RowBox[{"sol", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "//", "Evaluate"}], " ", ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "200"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1000"}], "}"}]}], "}"}]}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.957949337493031*^9, 3.95794942243577*^9}, {
  3.9579496235618*^9, 3.957949627215218*^9}, {3.9579496575415583`*^9, 
