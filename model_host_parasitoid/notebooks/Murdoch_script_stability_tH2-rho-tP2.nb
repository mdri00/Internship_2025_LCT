           RowBox[{"r", "/", "\[Delta]H2"}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"1", "/", "n"}], ")"}]}]}], " ", "-", " ", "1"}], ")"}], 
      "/", 
