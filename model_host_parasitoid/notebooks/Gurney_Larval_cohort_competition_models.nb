Cell[BoxData[{
 RowBox[{
  RowBox[{"solLimite", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"leqnICLCT", "/.", "parLimite"}], "/.", 
      RowBox[{"n", "->", "nn"}]}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"J", "[", "1", "]"}], ",", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"J", "[", "i", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "2", ",", "nn"}], "}"}]}], "]"}], ",", "A"}], 
       "}"}], "//", "Flatten"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", "tmax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"J", "[", "t", "]"}], "/.", " ", 
       RowBox[{"solLimite", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "//", "Evaluate"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"A", "[", "t", "]"}], "/.", 
       RowBox[{"solLimite", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "//", "Evaluate"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "->", "Full"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<J\>\"", ",", " ", "\"\<A\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]"}], "Input",
