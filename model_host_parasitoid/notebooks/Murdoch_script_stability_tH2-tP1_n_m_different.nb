Cell[BoxData[{
 RowBox[{"ClearAll", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DATADIR", " ", "=", " ", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{
      RowBox[{"ParentDirectory", "[", "]"}], ",", " ", "\"\</data/raw\>\""}], 
     "]"}]}], " ", ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CreateMatrix", "[", 
    RowBox[{"nn_", ",", " ", "mm_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"J", ",", "vars", ",", "i"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{"Variables", " ", "du", " ", "syst\[EGrave]me"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vars", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"H", "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "nn"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", "H2", "}"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"P", "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "mm"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", "P2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Initialiser", " ", "la", " ", "matrice", " ", "jacobienne", " ", 
        "avec", " ", "des", " ", "z\[EAcute]ros"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"J", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"nn", "+", "mm", "+", "2"}], ",", 
           RowBox[{"nn", "+", "mm", "+", "2"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Remplissage", " ", "de", " ", "la", " ", "sous"}], "-", 
        RowBox[{"matrice", " ", "pour", " ", 
         RowBox[{"H", "[", "i", "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"J", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"-", "\[Theta]H"}], "-", "\[Delta]H1", "-", 
           RowBox[{"a", " ", 
            RowBox[{"P2", "[", "t", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", ">", "1"}], ",", 
           RowBox[{
            RowBox[{"J", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", 
               RowBox[{"i", "-", "1"}]}], "]"}], "]"}], "=", "\[Theta]H"}]}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nn"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Remplissage", " ", "des", " ", "termes", " ", "de", " ", 
        "parasitisme"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"J", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", 
            RowBox[{"nn", "+", "mm", "+", "2"}]}], "]"}], "]"}], "=", 
         RowBox[{
          RowBox[{"-", "a"}], "*", 
          RowBox[{
           RowBox[{"H", "[", "i", "]"}], "[", "t", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nn"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Termes", " ", "li\[EAcute]s", " ", "\[AGrave]", " ", "H2"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"J", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", 
          RowBox[{"nn", "+", "1"}]}], "]"}], "]"}], "=", "r"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"H1", " ", "d\[EAcute]pend", " ", "de", " ", "H2"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"J", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"nn", "+", "1"}], ",", "nn"}], "]"}], "]"}], "=", 
       "\[Theta]H"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"H2", " ", "d\[EAcute]pend", " ", "de", " ", 
        RowBox[{"H", "[", "k", "]"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"J", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"nn", "+", "1"}], ",", 
          RowBox[{"nn", "+", "1"}]}], "]"}], "]"}], "=", 
       RowBox[{"-", "\[Delta]H2"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Remplissage", " ", "de", " ", "la", " ", "sous"}], "-", 
        RowBox[{"matrice", " ", "pour", " ", 
         RowBox[{"P", "[", "i", "]"}]}]}], "*)"}], 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"J", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"nn", "+", "1", "+", "i"}], ",", 
             RowBox[{"nn", "+", "1", "+", "i"}]}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"-", "\[Theta]P"}], "-", "\[Delta]P1"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", ">", "1"}], ",", 
           RowBox[{
            RowBox[{"J", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"nn", "+", "1", "+", "i"}], ",", 
               RowBox[{"nn", "+", "i"}]}], "]"}], "]"}], "=", "\[Theta]P"}]}],
           "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "mm"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Remplissage", " ", "des", " ", "termes", " ", "de", " ", 
        "parasitisme"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"J", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"nn", "+", "2"}], ",", "i"}], "]"}], "]"}], "=", 
         RowBox[{"a", "  ", 
          RowBox[{"P2", "[", "t", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nn"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"J", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"nn", "+", "2"}], ",", " ", 
          RowBox[{"nn", "+", "mm", "+", "2"}]}], "]"}], "]"}], " ", "=", " ", 
       
       RowBox[{"a", "*", 
        RowBox[{"H1", "[", "t", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Ligne", " ", "de", " ", "P2"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"J", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"nn", "+", "mm", "+", "2"}], ",", 
          RowBox[{"nn", "+", "mm", "+", "1"}]}], "]"}], "]"}], "=", 
       "\[Theta]P"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"J", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"nn", "+", "mm", "+", "2"}], ",", 
          RowBox[{"nn", "+", "mm", "+", "2"}]}], "]"}], "]"}], "=", 
       RowBox[{"-", "\[Delta]P2"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Retourner", " ", "la", " ", "matrice", " ", "jacobienne"}], 
       "*)"}], "\[IndentingNewLine]", "J"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.953621134528728*^9, 3.953621149832917*^9}, {
  3.959752883433169*^9, 3.959752883533085*^9}, {3.9597530914144077`*^9, 
  3.959753092354623*^9}, {3.959754841033882*^9, 3.959754843297784*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"87ddd0f4-1d50-40a3-a020-5cb1d413ca12"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Test : calcul de la courbe en fonction de tP1 (=\[Tau]2)", "Chapter",
 CellChangeTimes->{{3.953621998398417*^9, 3.9536220150130167`*^9}, {
  3.9597526447964287`*^9, 
  3.95975264927183*^9}},ExpressionUUID->"5caf1cc5-e864-4947-9568-\
ac28570b943a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Tau]2Min", "=", "0.011"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Tau]2Max", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Tau]2Pas", "=", "0.02"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"CourbeLimite", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"t2", "=", "\[Tau]2Max"}], ",", 
    RowBox[{"t2", ">", "\[Tau]2Min"}], ",", 
    RowBox[{"t2", "-=", "\[Tau]2Pas"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "tsol", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<t2 = \>\"", ",", "t2"}], "]"}], ";"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tsol", "=", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"ta", "/.", " ", 
           RowBox[{"FindRoot", "[", 
            RowBox[{
             RowBox[{"VP", "[", 
              RowBox[{"ta", ",", "t2"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"ta", ",", "0.01", ",", "5"}], "}"}], ",", 
             RowBox[{"Method", "->", "\"\<Brent\>\""}]}], "]"}]}], ",", 
          "\"\<Failed\>\""}], "]"}]}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Use", " ", "Quiet", " ", "to", " ", "suppress", " ", "warnings"}], 
         ",", 
         RowBox[{"Check", " ", "to", " ", "handle", " ", "failures"}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"NumericQ", "[", "tsol", "]"}], "&&", 
          RowBox[{"tsol", ">", "0"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"CourbeLimite", ",", 
           RowBox[{"{", 
            RowBox[{"tsol", ",", "t2"}], "}"}]}], "]"}]}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<Skipping t2 = \>\"", ",", "t2", ",", 
           "\"\< (FindRoot failed)\>\""}], "]"}], "*)"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}], "\[IndentingNewLine]", "CourbeLimite", "\[IndentingNewLine]"}], \
"Input",
 CellChangeTimes->{{3.9536211463814793`*^9, 3.953621156380186*^9}, {
