Cell[CellGroupData[{

Cell["\<\
Diagrammes de stabilit\[EAcute] tP1-tH2 en fonction de la variab dev. \
spatiale (k)\
\>", "Section",
 CellChangeTimes->{{3.955178689926963*^9, 
  3.9551787087068777`*^9}},ExpressionUUID->"4ceaa156-7bc1-431a-a5fb-\
1726289034f4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"parPI", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Tau]1", "\[Rule]", "1"}], ",", 
     RowBox[{"\[Delta]H1", "\[Rule]", "0"}], ",", 
     RowBox[{"\[Delta]P1", "\[Rule]", "1"}], ",", 
     RowBox[{"a", "\[Rule]", "1"}], ",", 
     RowBox[{"\[Delta]P2", "\[Rule]", "8"}], ",", 
     RowBox[{"\[Rho]", "\[Rule]", "33"}], ",", 
     RowBox[{"k", "\[Rule]", "1"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"reel", "=", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"Re", "[", 
     RowBox[{
      RowBox[{"EqCaraPI", "/.", 
       RowBox[{"{", 
        RowBox[{"s", "\[Rule]", 
         RowBox[{"x", " ", "I"}]}], "}"}]}], "/.", "parPI"}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"imag", "=", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"Im", "[", 
     RowBox[{
      RowBox[{"EqCaraPI", "/.", 
       RowBox[{"{", 
        RowBox[{"s", "\[Rule]", 
         RowBox[{"x", " ", "I"}]}], "}"}]}], "/.", "parPI"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xtempo", " ", "=", " ", "2.12"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tP1tempo", " ", "=", " ", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VPthierry", "[", "tH2_", "]"}], " ", ":=", " ", 
  RowBox[{"tP1", "/.", 
   RowBox[{"FindRoot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"reel", ",", "imag"}], "}"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Delta]H2", "->", 
         RowBox[{"1", "/", "tH2"}]}], ",", " ", 
        RowBox[{"\[Tau]2", "->", "tP1"}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "xtempo"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"tP1", ",", "tP1tempo"}], "}"}]}], "]"}]}]}], "\n", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tH2val", ",", " ", 
       RowBox[{"VPthierry", "[", "tH2val", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"tH2val", ",", "0.05", ",", "5", ",", " ", ".05"}], "}"}]}], 
    "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "100"}], "}"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"\"\<k = \>\"", "<>", 
     RowBox[{"ToString", "[", 
      RowBox[{"k", "/.", "parPI"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"ScalingFunctions", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", "\"\<Log\>\""}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.955178727057069*^9, 3.9551787831875963`*^9}, {
