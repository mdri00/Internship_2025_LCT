Cell[TextData[{
 "La premi\[EGrave]re VP est n\[EAcute]gative pour tout param\[EGrave]tre. La \
deuxi\[EGrave]me VP est strictement positive quand ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"-", "4"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"\[Delta]a", " ", "\[Delta]j", " ", 
      RowBox[{"Log", "[", 
       FractionBox["q", 
        RowBox[{"\[Delta]a", "+", 
         RowBox[{"\[Delta]a", " ", "\[Delta]j", " ", "\[Tau]1"}]}]], "]"}]}], 
     "+", 
     FractionBox[
      RowBox[{"\[Delta]a", " ", 
       RowBox[{"Log", "[", 
        FractionBox["q", 
         RowBox[{"\[Delta]a", "+", 
          RowBox[{"\[Delta]a", " ", "\[Delta]j", " ", "\[Tau]1"}]}]], "]"}]}],
       "\[Tau]1"]}], ")"}]}]], "Output",
  CellChangeTimes->{
   3.9199249554790297`*^9, 3.9199249888669243`*^9, 3.920950367114656*^9, 
    3.921050287300075*^9, 3.923389866469324*^9, 3.923390293716529*^9, 
    3.923392761028512*^9, 3.923392969134905*^9, 3.9233930323533583`*^9, 
    3.9233939636522913`*^9, 3.954760945681275*^9, {3.954763661298263*^9, 
    3.95476367019934*^9}, 3.954764026119747*^9, 3.954817963873096*^9},
  ExpressionUUID->"8306cc9f-83e2-4da9-b513-d086fb93db53"],
 " est strictement n\[EAcute]gatif ie quand le log est strictement \
n\[EAcute]gatif ie quand ",
 StyleBox["q < \[Delta]a(1+\[Delta]j \[Tau]1)",
  FontWeight->"Bold"],
 ".\nDonc l\[CloseCurlyQuote]\[EAcute]quilibre non trivial est stable pour q>\
\[Delta]a(1+\[Delta]j \[Tau]1) : cela correspond \[AGrave] la condition d\
\[CloseCurlyQuote]existence d\[CloseCurlyQuote]un \[EAcute]quilibre non \
trivial positif. Donc ",
 StyleBox["si l\[CloseCurlyQuote]\[EAcute]quilibre non-trivial existe, il est \
stable.",
  FontWeight->"Bold"]
}], "Text",
