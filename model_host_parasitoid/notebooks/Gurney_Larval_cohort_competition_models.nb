Cell[CellGroupData[{

Cell["\<\
Application : deux jeux de param\[EGrave]tres inspir\[EAcute]s de Gurney 1983 \
: Quentin, Plodia ventura\
\>", "Section",
 CellChangeTimes->{{3.957256114760098*^9, 3.957256128414324*^9}, {
  3.9572561860401373`*^9, 
  3.9572561967003*^9}},ExpressionUUID->"d8d7bc60-9f9d-4ac8-b99f-c4d8619fe23a"],

Cell[CellGroupData[{

Cell["Identification des deux mod\[EGrave]les", "Subsection",
 CellChangeTimes->{{3.957256139287991*^9, 
  3.957256148254992*^9}},ExpressionUUID->"9997a0bb-da31-45c9-a34c-\
da03df4a2402"],

Cell[TextData[{
 StyleBox["Pour rappel, ",
  FontVariations->{"Underline"->True}],
 "on consid\[EAcute]rait l\[CloseCurlyQuote]\[EAcute]quation:\n\tA\
\[CloseCurlyQuote][t] == q A[t - \[Tau]1 ] Exp[-A[t - \[Tau]1]/A0] Exp[-\
\[Delta]j \[Tau]1]  - \[Delta]a A[t]",
 StyleBox["\nCorrespondance des param\[EGrave]tres :",
  FontVariations->{"Underline"->True}],
 " on se rapport \[AGrave] l\[CloseCurlyQuote]\[EAcute]quation (2) de Beretta \
& Breda 2016.",
 "\n\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "Beretta"], TraditionalForm]],ExpressionUUID->
  "782950ca-9f76-4c7f-af31-ffd66dd44ace"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", " ", 
    FractionBox["1", 
     SubscriptBox[
      RowBox[{"N", " "}], "0"]]}], TraditionalForm]],ExpressionUUID->
  "9818b507-e005-4471-914e-59118f53e37d"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "Beretta"], TraditionalForm]],ExpressionUUID->
  "4b0a6d7f-f286-498a-a200-5227059cf311"],
 " = q\n\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["d1", 
    RowBox[{"Beretta", " "}]], TraditionalForm]],ExpressionUUID->
  "bfb8877a-92db-4ff0-af41-ae4aa19ae688"],
 " = \[Delta]j\n\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "Beretta"], TraditionalForm]],ExpressionUUID->
  "2f162176-07c9-424e-8281-c0ba68b94306"],
 " = \[Delta]a\n\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Tau]", "Beretta"], TraditionalForm]],ExpressionUUID->
  "8ca8795d-38c9-41ac-b4ae-6e97a387bb94"],
 " = \[Tau]1"
}], "Text",
 CellChangeTimes->{{3.9572558151217546`*^9, 3.95725586694366*^9}, {
  3.957255924489338*^9, 3.957256015318616*^9}, {3.957256060194481*^9, 
  3.957256083443754*^9}},ExpressionUUID->"6b22504a-2543-4915-afec-\
6cab2feca658"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"aB", "  ", "=", " ", 
   FractionBox["1", "A0"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bB", " ", "=", " ", "q"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d1B", " ", "=", " ", "\[Delta]j"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dB", "=", " ", "\[Delta]a"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Tau]B", " ", "=", " ", "\[Tau]1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Eta]B", " ", "=", " ", 
   RowBox[{"Log", "[", 
    FractionBox["bB", "dB"], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.957255875034829*^9, 3.957255912354835*^9}, {
  3.957255957207488*^9, 3.957255960653936*^9}, {3.9572559945805807`*^9, 
  3.957255995199451*^9}, {3.9572564143426943`*^9, 3.957256417544986*^9}, {
  3.957256570999155*^9, 3.957256571694133*^9}},
 CellLabel->
  "In[134]:=",ExpressionUUID->"e7fb90b7-7683-43e8-9a12-3e8091f9513b"],

Cell[TextData[{
 "Rappel : sous LCT, \n\t",
 Cell[BoxData[
  RowBox[{"EqNTMathis", " ", "=", " ", 
   RowBox[{
    RowBox[{"A0", "*", 
     RowBox[{"Log", "[", 
      RowBox[{
       FractionBox["q", "\[Delta]a"], 
       RowBox[{
        RowBox[{"(", "fJ", ")"}], "^", "n"}]}], "]"}]}], " ", "//", " ", 
    "FullSimplify"}]}]], "Input",
  CellChangeTimes->{{3.954832252293003*^9, 3.954832283050539*^9}, {
   3.954832330459601*^9, 3.95483246105678*^9}, {3.9548326823100557`*^9, 
   3.954832740927156*^9}},ExpressionUUID->
  "cac39901-33c8-41e7-ba37-15e33b63f5b2"]
}], "Text",
 CellChangeTimes->{{3.957256513558186*^9, 3.957256521331012*^9}, {
  3.9572568932312107`*^9, 
  3.957256893231283*^9}},ExpressionUUID->"f085043a-174d-48fb-86ba-\
8fa9dd6f5533"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"enB", "[", "z_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      FractionBox["z", "n"]}], ")"}], "^", "n"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"EqNT", " ", "=", " ", 
  FractionBox[
   RowBox[{"\[Eta]B", " ", "-", " ", 
    RowBox[{"Log", "[", 
     RowBox[{"enB", "[", 
      RowBox[{"d1B", " ", "\[Tau]B"}], "]"}], "]"}]}], "aB"], " "}]}], "Input",
 CellChangeTimes->{
  3.957261679661989*^9},ExpressionUUID->"cba18f11-a3a2-4b55-8a1e-\
2e9bcf0877a0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fJ", " ", "=", " ", 
   FractionBox["\[Theta]", 
    RowBox[{"\[Theta]", "+", "\[Delta]j"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"EqNTMathis", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"A0", "*", 
     RowBox[{"Log", "[", 
      RowBox[{
       FractionBox["q", "\[Delta]a"], 
       RowBox[{
        RowBox[{"(", "fJ", ")"}], "^", "n"}]}], "]"}]}], " ", "/.", " ", 
