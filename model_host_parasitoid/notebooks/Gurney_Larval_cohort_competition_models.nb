          RowBox[{
           RowBox[{"\[Delta]a", "->", "da"}], ",", " ", 
           RowBox[{"\[Tau]1", "->", "t1"}]}], "}"}]}], "/.", "parTable1"}], "/.", 
       RowBox[{"{", 
        RowBox[{"n", "->", "nn"}], "}"}]}], "]"}], " ", "//", "Re"}], " ", "//",
     " ", "Max"}]}], ";"}], "\n", 
