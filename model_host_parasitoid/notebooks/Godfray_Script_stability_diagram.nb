  FormBox[
   RowBox[{"ln", "(", 
    RowBox[{"1", "+", 
     RowBox[{"a", " ", 
      SubscriptBox["P", "2"]}]}]}], TraditionalForm]],ExpressionUUID->
  "cb4d9ac0-d41e-4db3-975d-950e5dcb8bb5"],
