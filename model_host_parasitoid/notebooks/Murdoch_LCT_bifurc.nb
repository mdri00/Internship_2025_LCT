Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Create", " ", "the", " ", "bifurcation", " ", "plot"}], "*)"}], 
  RowBox[{
   RowBox[{"bifurcationPlot1", "=", 
    RowBox[{"ListPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"(*", 
        RowBox[{"Plot", " ", "equilibrium", " ", "points"}], "*)"}], 
       RowBox[{
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"bifurcationData", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "4", "]"}], "]"}], "==", "\"\<equilibrium\>\""}], 
            "&"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}], ",", 
        RowBox[{"(*", 
         RowBox[{
         "Plot", " ", "min", " ", "values", " ", "for", " ", "limit", " ", 
