Cell["Et si on prend les param\[EGrave]tres de Plodia :", "Text",
 CellChangeTimes->{{3.956213575630702*^9, 3.956213580778574*^9}, {
  3.956213675971664*^9, 
  3.956213680808579*^9}},ExpressionUUID->"57651024-f6ab-4453-9db8-\
a7d5cef63c5f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"parTablePlodia", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Delta]j", " ", "->", " ", "0."}], ",", 
     RowBox[{"q", "->", " ", "9.4"}], ",", " ", 
     RowBox[{"A0", "->", "15"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VPMaxLCT1", "[", 
    RowBox[{"da_", ",", " ", "t1_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Eigenvalues", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"lJeqNonTriLCT", "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Delta]a", "->", "da"}], ",", " ", 
           RowBox[{"\[Tau]1", "->", "t1"}]}], "}"}]}], "/.", 
        "parTablePlodia"}], "/.", 
       RowBox[{"{", 
        RowBox[{"n", "->", "nn"}], "}"}]}], "]"}], " ", "//", "Re"}], " ", "//",
     " ", "Max"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"table1", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Delta]a", ",", " ", "\[Tau]1", ",", " ", 
       RowBox[{"VPMaxLCT1", "[", 
        RowBox[{"\[Delta]a", ",", " ", "\[Tau]1"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Delta]a", ",", " ", "0.01", ",", "1", ",", "0.02"}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"\[Tau]1", ",", " ", "0.01", ",", "50", ",", "1"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"table1flat", " ", "=", " ", 
    RowBox[{"Flatten", "[", 
     RowBox[{"table1", ",", "1"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Flatten", " ", "first", " ", "and", " ", "second", " ", "dimension"}], 
    " ", "->", " ", 
    RowBox[{"have", " ", "a", " ", "list", " ", "of", " ", "triplets"}]}], 
   "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"StabContourPlot", " ", "=", " ", 
    RowBox[{"ListContourPlot", "[", 
     RowBox[{"table1flat", ",", "\[IndentingNewLine]", 
      RowBox[{"ImageSize", "->", 
       RowBox[{"{", 
        RowBox[{"400", ",", "400"}], "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"AspectRatio", "\[Rule]", " ", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Frame", "->", 
       RowBox[{"{", 
