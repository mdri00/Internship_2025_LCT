              RowBox[{"fP", "^", 
               RowBox[{"(", 
                RowBox[{"m", "-", "1"}], ")"}]}]}], ")"}]}]}], " ", "//", " ",
           "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
