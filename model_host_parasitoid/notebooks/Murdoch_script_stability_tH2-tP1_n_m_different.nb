     "\[IndentingNewLine]", "\"\<_dP1_\>\"", ",", 
     RowBox[{"ToString", "[", 
      RowBox[{"\[Delta]P1", "/.", "paramsplot"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Folder", "=", 
    RowBox[{"\"\<Murdoch_stability_n_m_tH2-tP1_\>\"", "<>", "paramInfo"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"CreateDirectory", "[", "Folder", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Storage", " ", "for", " ", "results"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"StabilityCurveData", "=", 
    RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Loop", " ", "through", " ", "parameter", " ", "values"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"For", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"i", "=", "1"}], ",", 
     RowBox[{"i", "<=", 
      RowBox[{"Length", "[", "nValues", "]"}]}], ",", 
     RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{"For", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"j", "=", " ", "1"}], ",", " ", 
       RowBox[{"j", "<=", " ", 
        RowBox[{"Length", "[", "mValues", "]"}]}], ",", " ", 
       RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", " ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"currentN", "=", 
            RowBox[{"nValues", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ",", 
           RowBox[{"currentM", " ", "=", " ", 
            RowBox[{"mValues", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], ",", "sol", ",", "analysis"}], 
          "}"}], ",", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "Set", " ", "up", " ", "the", " ", "system", " ", "with", " ", 
            "current", " ", "n"}], "=", 
           RowBox[{"m", " ", "value"}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"nn", "=", "currentN"}], ";", "\[IndentingNewLine]", 
          RowBox[{"mm", "=", "currentM"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", "nn", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", "mm", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Clear", "[", 
           RowBox[{
           "\[Delta]P1", ",", "n", ",", "m", ",", " ", "\[Delta]H1", ",", " ",
             "\[Delta]P1", ",", " ", "\[Delta]H2", ",", " ", "\[Delta]P2", 
            ",", " ", "\[Rho]", ",", "\[Beta]", ",", " ", "mP", ",", " ", 
            "mH"}], "]"}], ";", " ", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"H1", "[", "t", "]"}], "=", " ", 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"i", "=", "1"}], "nn"], 
            RowBox[{
             RowBox[{"H", "[", "i", "]"}], "[", "t", "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"P1", "[", "t", "]"}], "=", " ", 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"i", "=", "1"}], "mm"], 
            RowBox[{
             RowBox[{"P", "[", "i", "]"}], "[", "t", "]"}]}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"fH", " ", "=", " ", 
           RowBox[{"\[Theta]H", " ", "/", " ", 
            RowBox[{"(", 
             RowBox[{"\[Theta]H", " ", "+", " ", "\[Delta]H1"}], ")"}]}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"fP", " ", "=", " ", 
           RowBox[{"\[Theta]P", " ", "/", " ", 
            RowBox[{"(", 
             RowBox[{"\[Theta]P", " ", "+", " ", "\[Delta]P1"}], ")"}]}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"P2eqpredi", " ", "=", " ", 
           RowBox[{
            RowBox[{"\[Theta]H", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"fH", " ", "*", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"r", "/", "\[Delta]H2"}], ")"}], "^", 
                  RowBox[{"(", 
                   RowBox[{"1", "/", "n"}], ")"}]}]}], " ", "-", " ", "1"}], 
               ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"a", " ", "fH"}], ")"}]}]}], " ", "//", " ", 
            "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"sH", " ", "=", " ", 
           RowBox[{"\[Theta]H", " ", "/", " ", 
            RowBox[{"(", 
             RowBox[{
             "\[Theta]H", " ", "+", " ", "\[Delta]H1", " ", "+", " ", 
              RowBox[{"a", " ", "P2eqpredi"}]}], ")"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"\[Alpha]H", " ", "=", " ", 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"i", "=", "0"}], 
             RowBox[{"n", "-", "1"}]], 
            RowBox[{
             RowBox[{"(", "sH", ")"}], "^", "i"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"\[Alpha]P", " ", "=", " ", 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"i", "=", "0"}], 
             RowBox[{"m", "-", "1"}]], 
            RowBox[{"fP", "^", "i"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"H1eqpredi", " ", "=", " ", 
           RowBox[{"\[Delta]P2", "/", 
            RowBox[{"(", 
             RowBox[{"a", "*", 
              RowBox[{"fP", "^", "m"}]}], ")"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"H2eqpredi", " ", "=", " ", 
           RowBox[{
            RowBox[{"H1eqpredi", " ", "*", " ", "\[Theta]H", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"r", "/", "\[Delta]H2"}], ")"}], "^", 
                 RowBox[{"(", 
                  RowBox[{"1", "/", "n"}], ")"}]}], "-", "1"}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"\[Delta]H2", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"r", "/", "\[Delta]H2"}], ")"}], "-", "1"}], 
                 ")"}]}], ")"}]}]}], " ", "//", " ", "FullSimplify"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"P1eqpredi", " ", "=", " ", 
           RowBox[{
            RowBox[{"P2eqpredi", " ", "*", " ", "\[Alpha]P", " ", "*", " ", 
             RowBox[{"\[Delta]P2", " ", "/", 
              RowBox[{"(", 
               RowBox[{"\[Theta]P", "*", 
                RowBox[{"fP", "^", 
                 RowBox[{"(", 
                  RowBox[{"m", "-", "1"}], ")"}]}]}], ")"}]}]}], " ", "//", 
            " ", "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"\[Theta]H", " ", "=", " ", 
           RowBox[{"n", "*", "mH"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"\[Theta]P", " ", "=", " ", 
           RowBox[{"m", "*", "mP"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"r", " ", "=", " ", 
