            RowBox[{
             RowBox[{"{", "tsol", "}"}], ",", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{"\"\<t2 = \>\"", ",", "t2"}], "]"}], ";"}], "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"tsol", "=", 
               RowBox[{"Check", "[", 
                RowBox[{
                 RowBox[{"ta", "/.", " ", 
                  RowBox[{"FindRoot", "[", 
                   RowBox[{
                    RowBox[{"VP", "[", 
                    RowBox[{"ta", ",", "t2"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"ta", ",", "0.01", ",", "5"}], "}"}], ",", 
                    RowBox[{"Method", "->", "\"\<Brent\>\""}]}], "]"}]}], 
                 ",", "\"\<Failed\>\""}], "]"}]}], ";", " ", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{
                "Use", " ", "Quiet", " ", "to", " ", "suppress", " ", 
                 "warnings"}], ",", 
                RowBox[{
                "Check", " ", "to", " ", "handle", " ", "failures"}]}], 
               "*)"}], "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"NumericQ", "[", "tsol", "]"}], "&&", 
                 RowBox[{"tsol", ">", "0"}]}], ",", "\[IndentingNewLine]", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{"CourbeLimite", ",", 
