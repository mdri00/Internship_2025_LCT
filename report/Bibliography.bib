@article{cronin_variable_2016,
	title = {Variable prey development time suppresses predator–prey cycles and enhances stability},
	volume = {19},
	issn = {1461-023X, 1461-0248},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/ele.12571},
	doi = {10.1111/ele.12571},
	abstract = {Abstract
            Although theoretical models have demonstrated that predator–prey population dynamics can depend critically on age (stage) structure and the duration and variability in development times of different life stages, experimental support for this theory is non‐existent. We conducted an experiment with a host–parasitoid system to test the prediction that increased variability in the development time of the vulnerable host stage can promote interaction stability. Host–parasitoid microcosms were subjected to two treatments: Normal and High variance in the duration of the vulnerable host stage. In control and Normal‐variance microcosms, hosts and parasitoids exhibited distinct population cycles. In contrast, insect abundances were 18–24\% less variable in High‐ than Normal‐variance microcosms. More significantly, periodicity in host–parasitoid population dynamics disappeared in the High‐variance microcosms. Simulation models confirmed that stability in High‐variance microcosms was sufficient to prevent extinction. We conclude that developmental variability is critical to predator–prey population dynamics and could be exploited in pest‐management programs.},
	pages = {318--327},
	number = {3},
	journaltitle = {Ecology Letters},
	shortjournal = {Ecology Letters},
	author = {Cronin, James T. and Reeve, John D. and Xu, Dashun and Xiao, Mingqing and Stevens, Heidi N.},
	editor = {Holyoak, Marcel},
	urldate = {2025-03-31},
	date = {2016-03},
	langid = {english},
	keywords = {main},
	file = {Cronin_2016_SM:/home/mathisdr/Zotero/storage/T8NNCC3C/Cronin_2016_SM.docx:application/vnd.openxmlformats-officedocument.wordprocessingml.document;Cronin_2016_SM:/home/mathisdr/Zotero/storage/S8AD3JQM/Cronin_2016_SM.pdf:application/pdf;PDF:/home/mathisdr/Zotero/storage/SX3VZTAP/Cronin et al. - 2016 - Variable prey development time suppresses predator–prey cycles and enhances stability.pdf:application/pdf},
}

@article{murdoch_host_2005,
	title = {Host Suppression and Stability in a Parasitoid-Host System: Experimental Demonstration},
	volume = {309},
	issn = {0036-8075, 1095-9203},
	url = {https://www.science.org/doi/10.1126/science.1114426},
	doi = {10.1126/science.1114426},
	shorttitle = {Host Suppression and Stability in a Parasitoid-Host System},
	abstract = {We elucidate the mechanisms causing stability and severe resource suppression in a consumer-resource system. The consumer, the parasitoid
              Aphytis
              , rapidly controlled an experimentally induced outbreak of the resource, California red scale, an agricultural pest, and imposed a low, stable pest equilibrium. The results are well predicted by a mechanistic, independently parameterized model. The key mechanisms are widespread in nature: an invulnerable adult stage in the resource population and rapid consumer development. Stability in this biologically nondiverse agricultural system is a property of the local interaction between these two species, not of spatial processes or of the larger ecological community.},
	pages = {610--613},
	number = {5734},
	journaltitle = {Science},
	shortjournal = {Science},
	author = {Murdoch, William and Briggs, Cheryl J. and Swarbrick, Susan},
