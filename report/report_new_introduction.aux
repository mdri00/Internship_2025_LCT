\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}The sensitivity of the refuge-stage effect to developmental variability : Murdoch (1987) model}{9}\protected@file@percent }
\newlabel{fig:a}{{3a}{10}}
\newlabel{sub@fig:a}{{a}{10}}
\newlabel{fig:b}{{3b}{10}}
\newlabel{sub@fig:b}{{b}{10}}
\newlabel{fig:c}{{3c}{10}}
\newlabel{sub@fig:c}{{c}{10}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Effect of maturation variability on different properties of the Murdoch 1987 model. \textbf  {(a)} : Non trivial equilibrium densities (noted $X^*$ for each stage X) as a function of the Erlang distribution shapes n and m. Parameters are $\delta _{H1} = 0, \delta _{P1} = 1, \delta _{P2} = 8, \rho = 33, a = 1, m_P = 1, \delta _{H2} = 1/T_{H2} = 0.2$. The system displays a limit cycle to the right of the dashed red line (for n,m > 10). \textbf  {(b)} : Local stability diagram of the system around the non-trivial equilibrium. The system is unstable to the left of the curves, and stable to their right. \textbf  {(c)} : Bifurcation diagram of the system with parameters inspired from those in Wearing 2004 : $\delta _{H1} = 0.00425, \delta _{P1} = 0.1, \delta _{P2} = 0.5, \rho = 105, m_P = 0.05, T_{H2} = 1/\delta _{H2} = 5, T_{H1} = 1/m_H = 37$.\relax }}{10}\protected@file@percent }
\newlabel{fig:Murdoch}{{3}{10}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Sensitivity of the phenological-mismatch-effect to developmental variability : Godfray and Hassel (1989) model}{10}\protected@file@percent }
\newlabel{fig:a}{{4a}{11}}
\newlabel{sub@fig:a}{{a}{11}}
\newlabel{fig:b}{{4b}{11}}
\newlabel{sub@fig:b}{{b}{11}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Maturation-variability-dependent effect of host fecundity on the stability properties of the Murdoch 1987 model, given by bifurcation diagrams. In both subfigures, parameters are inspired from those taken in Murdoch 1987 : $m_H = 1/T_{H1} = 1, \delta _{H1} = 0, \delta _{P1} = 1, \delta _{P2} = 8, \rho = 33, a = 1, m_P = 1/T_{P1} = 1$. \textbf  {(a)} : $\delta _{H2} = 1/T_{H2} = 0.15$ . \textbf  {(b)} : $\delta _{H2} = 1/T_{H2} = 1$ .\relax }}{11}\protected@file@percent }
\newlabel{fig:Godfray}{{4}{11}}
\newlabel{fig:a}{{5a}{12}}
\newlabel{sub@fig:a}{{a}{12}}
\newlabel{fig:b}{{5b}{12}}
\newlabel{sub@fig:b}{{b}{12}}
\newlabel{fig:c}{{5c}{12}}
\newlabel{sub@fig:c}{{c}{12}}
\newlabel{fig:d}{{5d}{12}}
\newlabel{sub@fig:d}{{d}{12}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Effect of maturation variability on different properties of the Godfray and Hassel 1989 model. In all subfigures, parameters are inspired from Xu et al. 2010 : $m_{H1} = 1/3, m_{H2} = 1/2, m_{H3} = 1/3, \delta _{H1} = \delta _{H2} = \delta _{H3} = 0, \delta _{H4} = 1, \delta _{P1} = 0, \delta _{P2} = 2.5, r = 15, a = 0.01, k = 1, ratioT = 1, n_1 = 50, n_2 = 50.$ \textbf  {(a)} : Non trivial equilibrium densities (noted $X^*$ for each stage X) as a function of $H_2$ and $P_1$ number of subcompartments $n_2 = m$ \textbf  {(b)} : Local stability boundaries taken from Xu et al. (2010) in the case of fixed delays for all stages. The stability boundaries are plotted with respect to the ratio of parasitoid to host generation times (ratioT) and the search aggregation parameter k. \textbf  {(c)} : Local stability boundaries for $n_2 = m = 3$ and various values of $(n_1,n_3)$ . For the stability curve on the right, all curves are perfectly superimposed such that only the one for $n_1 = n_3 = 500$ is drawn. \textbf  {(d)} : Local stability boundaries for $n_1 = n_3 = 300$ (except the grey curves taken from Xu et al. 2010 with fixed delays) related to the couples of characteristic roots responsible for the GC area at $ratioT \approx 1.5$. For clarity, the other "U" curves are not shown here.\relax }}{12}\protected@file@percent }
\newlabel{fig:Godfray}{{5}{12}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Comparing the effect of May's implementation of parasitism heterogeneity and the effect of developmental variability}{13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Effect of the type of parasitism risk heterogeneity on the stability of a 2-stage host-parasitoid system. The number of subcompartiments, or the shape for the Erlang distribution of maturation time is n. May's parasitism clumping parameter (May 1978) is k. One type of risk heterogeneity, either temporal with developmental variability (full lines) or spatial with May's pseudo-interference (dashed lines), was implemented at a time.\relax }}{13}\protected@file@percent }
\newlabel{fig:equivalence_k_n}{{6}{13}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Survey of Erlang/Gamma distribution shape (n)}{13}\protected@file@percent }
\newlabel{fig:a}{{7a}{14}}
\newlabel{sub@fig:a}{{a}{14}}
\newlabel{fig:b}{{7b}{14}}
\newlabel{sub@fig:b}{{b}{14}}
\newlabel{fig:c}{{7c}{14}}
\newlabel{sub@fig:c}{{c}{14}}
\newlabel{fig:d}{{7d}{14}}
\newlabel{sub@fig:d}{{d}{14}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Survey of Gamma shape parameter of insects stages found in literature. The Gamma fitting processed was conducted with 3 types of constraint : either the Gamma shift parameter ($\tau $) was forced to 0 ("$\tau = 0$"), either it was allowed in the range [0;1] ("$\tau \in [0;1]$"), or it was set equal to the given Weibull shift parameter ("$\tau $ copied"). Only stages like Egg, Larva, Pupa/Nymph and Proto/Deutonymph were retained. In (b), (c), and (d), parameter sets with negative Weibull shifts are excluded. \textbf  {(a)} : Fitted gamma shape parameters (n). Each grey line connects a couples of species and stage across the fitting constraints. The blue line indicates the sample median. The red line indicates the sample mean. \textbf  {(b)} : Wasserstein distance between the fitted Gamma distribution and the corresponding Weibull to determine the goodness-of-fit for the three fitting constraints \textbf  {(c)} : Fitted Gamma shape as a function of the original Weibull shift, with the constraint that the Gamma shift has to be null. \textbf  {(d)} : Wasserstein distance as a function of the original Weibull shift parameter across the three fitting constraints, with linear regression line estimated with the Ordinary Least Square method. \relax }}{14}\protected@file@percent }
\newlabel{fig:Survey}{{7}{14}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Summary statistics of the Weibull-to-Gamma distribution fitting across the three $\tau $ constraints. 62 sets of Weibull parameters were analyzed in total. The 5 sets of parameters with negative shifts are included in the lines about Wasserstein distances, and excluded otherwise. A significant shape change is counted when the fitted shape differs by at least 1 between the 2 given constraints.\relax }}{15}\protected@file@percent }
