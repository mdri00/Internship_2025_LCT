Cell[CellGroupData[{

Cell["\<\
Comparaison des zones d\[CloseCurlyQuote]existence de l\[CloseCurlyQuote]\
\[EAcute]quilibre NT en fonction du formalisme\
\>", "Section",
 CellChangeTimes->{{3.9557931463263597`*^9, 
  3.955793157530056*^9}},ExpressionUUID->"c98e94e9-5ba8-459c-97af-\
8545d5706142"],

Cell[TextData[{
 "3 expressions explicites de la courbe d\[CloseCurlyQuote]existence de l\
\[CloseCurlyQuote]\[EAcute]quilibre non trivial :\n-DDE : ",
 Cell[BoxData[
  RowBox[{"\[Delta]a", "<", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[Delta]j"}], " ", "\[Tau]1"}]], " ", "q"}]}]], "Output",
  CellChangeTimes->{{3.955016074591422*^9, 3.95501609438131*^9}, 
    3.955016605316948*^9, 3.955016695234909*^9, 3.955016809995737*^9, {
    3.955610528392477*^9, 3.9556105419523582`*^9}, 3.955793077932968*^9, 
    3.955805673538087*^9},ExpressionUUID->
  "1df814e1-2f0b-4ef6-90fc-60e2f7ea21b7"],
 "\n-ODE : \[Delta]a < ",
 Cell[BoxData[
  FractionBox["q", 
   RowBox[{"1", "+", 
    RowBox[{"\[Delta]j", " ", "\[Tau]1"}]}]]], "Output",
  CellChangeTimes->{{3.95602454193548*^9, 3.956024545166918*^9}},
  ExpressionUUID->"75bba636-21af-431b-9c29-4a6e7f1942f1"],
 "\n-LCT : \[Delta]a < ",
 Cell[BoxData[
  RowBox[{"q", " ", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox["n", 
      RowBox[{"n", "+", 
       RowBox[{"\[Delta]j", " ", "\[Tau]1"}]}]], ")"}], "n"]}]], "Output",
  CellChangeTimes->{3.9560246979219437`*^9},ExpressionUUID->
  "3dc7b2cd-7665-422d-af2e-09c60e30829e"],
 " (ok pour n=1  ODE ; pour n-> \[Infinity] DDE)"
}], "Text",
 CellChangeTimes->{{3.9560243635308743`*^9, 3.956024382928748*^9}, {
  3.956024414909185*^9, 3.956024418503125*^9}, {3.956024567152647*^9, 
  3.9560245738063*^9}, {3.956024646483275*^9, 3.9560247229416428`*^9}, {
  3.956024827063488*^9, 
  3.9560248421502666`*^9}},ExpressionUUID->"9cc87575-b9cb-4783-92c6-\
7bfbbd804476"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LimEqLCTn", "[", 
     RowBox[{"t1_", ",", "n_"}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"\[Delta]a", "/.", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"q", 
           RowBox[{
            RowBox[{"(", "fJ", ")"}], "^", "n"}]}], " ", "==", " ", 
          "\[Delta]a"}], ",", " ", "\[Delta]a"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"q", "->", "qq"}], ",", " ", 
       RowBox[{"\[Delta]j", " ", "->", " ", "\[Delta]jq"}], ",", " ", 
       RowBox[{"A0", "->", "A0q"}], ",", " ", 
       RowBox[{"n", "->", "nn"}], ",", " ", 
       RowBox[{"\[Tau]1", "->", "t1"}]}], "}"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DDEplot", " ", "=", " ", 
    RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"daLimNT", "[", "\[Tau]1", "]"}], "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"q", "->", "qq"}], ",", " ", 
              RowBox[{"\[Delta]j", " ", "->", " ", "\[Delta]jq"}], ",", " ", 
              RowBox[{"A0", "->", "A0q"}]}], "}"}]}], ",", " ", "\[Tau]1"}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Tau]1", ",", " ", "0.1", ",", "100"}], "}"}]}], "]"}], "//",
        "Evaluate"}], ",", "\[IndentingNewLine]", 
      RowBox[{"ImageSize", "->", 
       RowBox[{"{", 
        RowBox[{"400", ",", "400"}], "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"AspectRatio", "\[Rule]", " ", "1"}], ",", 
