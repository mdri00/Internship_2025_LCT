        RowBox[{"Clear", "[", "\[Delta]H1", "]"}], ";", " ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "On", " ", "utilise", " ", "les", " ", "mortalit\[EAcute]s", " ", 
