Cell["Test : calcul de la courbe en fonction de tP1 (=\[Tau]2)", "Chapter",
 CellChangeTimes->{{3.953621998398417*^9, 3.9536220150130167`*^9}, {
  3.9597526447964287`*^9, 
  3.95975264927183*^9}},ExpressionUUID->"5caf1cc5-e864-4947-9568-\
ac28570b943a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Tau]2Min", "=", "0.011"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Tau]2Max", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Tau]2Pas", "=", "0.02"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"CourbeLimite", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"t2", "=", "\[Tau]2Max"}], ",", 
    RowBox[{"t2", ">", "\[Tau]2Min"}], ",", 
    RowBox[{"t2", "-=", "\[Tau]2Pas"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "tsol", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<t2 = \>\"", ",", "t2"}], "]"}], ";"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tsol", "=", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"ta", "/.", " ", 
           RowBox[{"FindRoot", "[", 
            RowBox[{
             RowBox[{"VP", "[", 
              RowBox[{"ta", ",", "t2"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"ta", ",", "0.01", ",", "5"}], "}"}], ",", 
             RowBox[{"Method", "->", "\"\<Brent\>\""}]}], "]"}]}], ",", 
          "\"\<Failed\>\""}], "]"}]}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Use", " ", "Quiet", " ", "to", " ", "suppress", " ", "warnings"}], 
         ",", 
         RowBox[{"Check", " ", "to", " ", "handle", " ", "failures"}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"NumericQ", "[", "tsol", "]"}], "&&", 
          RowBox[{"tsol", ">", "0"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"CourbeLimite", ",", 
           RowBox[{"{", 
            RowBox[{"tsol", ",", "t2"}], "}"}]}], "]"}]}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<Skipping t2 = \>\"", ",", "t2", ",", 
           "\"\< (FindRoot failed)\>\""}], "]"}], "*)"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}], "\[IndentingNewLine]", "CourbeLimite", "\[IndentingNewLine]"}], \
"Input",
 CellChangeTimes->{{3.9536211463814793`*^9, 3.953621156380186*^9}, {
