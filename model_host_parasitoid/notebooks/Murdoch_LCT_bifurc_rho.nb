774c0c721b0b"],

Cell[" (\[EAcute]quilibre stable ou min et max des cycles limites stables)", \
"Text",
 CellChangeTimes->{
  3.953366717918721*^9},ExpressionUUID->"6317d3e7-31ea-45f3-ae36-\
7de90f8caf37"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"nmValues", "=", 
     RowBox[{"{", "50", "}"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tmax", " ", "=", " ", "1000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ComputingStatus", " ", "=", " ", "\"\<Setup\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"paramInfo", "=", 
     RowBox[{"StringJoin", "[", "\[IndentingNewLine]", 
      RowBox[{"\"\<tH2_\>\"", ",", 
       RowBox[{"ToString", "[", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"\[Delta]H2", "/.", "paramsplot"}], " ", ")"}]}], "//", 
         "N"}], "]"}], ",", "\[IndentingNewLine]", "\"\<_tP1_\>\"", ",", 
       RowBox[{"ToString", "[", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"mP", "/.", "paramsplot"}], " ", ")"}]}], "//", "N"}], 
        "]"}], ",", "\[IndentingNewLine]", "\"\<_dP2_\>\"", ",", 
       RowBox[{"ToString", "[", 
        RowBox[{"\[Delta]P2", "/.", "paramsplot"}], " ", "]"}], ",", 
       "\[IndentingNewLine]", "\"\<_dH1_\>\"", ",", 
       RowBox[{"ToString", "[", 
        RowBox[{"\[Delta]H1", "/.", "paramsplot"}], " ", "]"}], ",", 
       "\[IndentingNewLine]", "\"\<_dP1_\>\"", ",", 
       RowBox[{"ToString", "[", 
        RowBox[{"\[Delta]P1", "/.", "paramsplot"}], " ", "]"}], ",", 
       "\[IndentingNewLine]", "\"\<_n_\>\"", ",", 
       RowBox[{"ToString", "[", 
        RowBox[{"nn", "/.", "paramsplot"}], " ", "]"}], ",", 
       "\[IndentingNewLine]", "\"\<_m_\>\"", ",", 
       RowBox[{"ToString", "[", 
        RowBox[{"mm", "/.", "paramsplot"}], " ", "]"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Folder", "=", 
     RowBox[{"\"\<Murdoch_bifurcation_rho_\>\"", "<>", "paramInfo"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"CreateDirectory", "[", "Folder", "]"}], ";"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Storage", " ", "for", " ", "results"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bifurcationData", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bifurcationDataDescriptor", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "\"\<rho\>\"", ",", " ", "\"\<eq or min or max\>\"", ",", " ", 
       "\"\<stability type\>\"", ",", " ", "\"\<time between two peaks\>\""}],
       "}"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Loop", " ", "through", " ", "parameter", " ", "values"}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "rhoValues", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"currentrho", "=", 
            RowBox[{"rhoValues", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ",", "sol", ",", "analysis"}], 
          "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"ComputingStatus", " ", "=", " ", "\"\<Num resol\>\""}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"sol", "=", 
           RowBox[{"Check", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"NDSolve", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"leqnIC", "/.", " ", "paramsplot"}], "/.", 
                RowBox[{"{", 
                 RowBox[{"\[Rho]", "->", "currentrho"}], "}"}]}], ",", "vars",
                ",", 
               RowBox[{"{", 
                RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"Method", "->", 
                RowBox[{"{", "\"\<StiffnessSwitching\>\"", "}"}]}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"StepMonitor", ":>", 
                RowBox[{"(", 
                 RowBox[{"lastTime", "=", "t"}], ")"}]}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"MaxSteps", "->", " ", "100000"}]}], "]"}], ",", 
             RowBox[{"{", "\"\<StiffnessError\>\"", "}"}]}], 
            "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"ComputingStatus", " ", "=", " ", "\"\<Sol analysis\>\""}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"sol", "===", 
              RowBox[{"{", "\"\<StiffnessError\>\"", "}"}]}], "||", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"ValueQ", "[", "lastTime", "]"}], "&&", 
               RowBox[{"lastTime", "<", "tmax"}]}], ")"}]}], ",", 
            RowBox[{"Print", "[", "\"\<Failed\>\"", "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"analysis", "=", 
             RowBox[{"analyzeSolutionfreq", "[", 
              RowBox[{"sol", ",", " ", 
               RowBox[{"tmax", "-", "200"}], ",", "tmax"}], "]"}]}]}], "]"}], 
          ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"analysis", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "==", "\"\<equilibrium\>\""}], 
            ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"bifurcationData", ",", 
              RowBox[{"{", 
               RowBox[{"currentrho", ",", 
                RowBox[{"analysis", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<equilibrium\>\""}],
                "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"bifurcationData", ",", 
               RowBox[{"{", 
                RowBox[{"currentrho", ",", 
                 RowBox[{"analysis", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                 "\"\<min and time near min\>\"", ",", " ", 
                 RowBox[{"analysis", "[", 
                  RowBox[{"[", "4", "]"}], "]"}]}], "}"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"bifurcationData", ",", 
               RowBox[{"{", 
                RowBox[{"currentrho", ",", 
                 RowBox[{"analysis", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<max\>\""}], 
                "}"}]}], "]"}]}]}], "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "rhoValues", "]"}], ",", " ", 
       "ComputingStatus"}], "}"}]}], "\[IndentingNewLine]", "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"DATADIR", ",", " ", "Folder", ",", "\"\<rhoRange.csv\>\""}], 
        "}"}], "]"}], ",", "rhoValues"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
        "DATADIR", ",", " ", "Folder", ",", "\"\<parameters.csv\>\""}], "}"}],
        "]"}], ",", "paramsplot"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"DATADIR", ",", "Folder", ",", "\"\<description.csv\>\""}], 
        "}"}], "]"}], ",", "bifurcationDataDescriptor"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"DATADIR", ",", " ", "Folder", ",", "\"\<data.csv\>\""}], 
        "}"}], "]"}], ",", "bifurcationData"}], "]"}], ";"}]}]}]], "Input",
