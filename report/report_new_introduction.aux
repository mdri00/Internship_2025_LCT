\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Local stability diagram of the system around the non-trivial equilibrium showing the effect of the average number of offspring of an adult host $\rho $. Parameters are $\delta _{H1} = 0, \delta _{P1} = 1, \delta _{P2} = 8, \rho = 33, T_{H1} = 1/m_H = 1, m_P = 2$.}}{41}{}\protected@file@percent }
\newlabel{fig:murdoch_rho_suppl}{{3}{41}{Supplementary figures}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Bifurcation diagram of the Godfray and Hassel system with parameters inspired from those in Wearing 2004 : $m_{H1} = 0.23, m_{H2} = 0.04, m_{H3} = 0.12, m_P = 0.05, \delta _{H1} = 0.017, \delta _{H2} = \delta _{H3} = 0, \delta _{H4} = 0.18, \delta _{P1} = 0.1, \delta _{P2} = 0.5, r = 21, a = 0.03, k = 1, n_1 = 37, n_3 = 55$. With these parameters, ratiotT = 0.506.}}{42}{}\protected@file@percent }
\newlabel{fig:Godfray_bifurc}{{4}{42}{Supplementary figures}{figure.4}{}}
