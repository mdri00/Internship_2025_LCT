     RowBox[{"a", "*", 
      RowBox[{"fP", "^", "m"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H2eqpredi", " ", "=", " ", 
