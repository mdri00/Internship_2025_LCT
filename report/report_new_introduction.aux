\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The LCT-ODE host-parasitoid model based on the model described in Murdoch (1987). H1 and P1 population densities are equal to $\DOTSB \sum@ \slimits@ _{i=1}^{n} H_{1,i}(t)$ and $\DOTSB \sum@ \slimits@ _{i=1}^{m} P_{1,i}(t)$.}}{5}{}\protected@file@percent }
\newlabel{fig:system}{{1}{5}{Host-parasitoid models in continuous time}{figure.1}{}}
