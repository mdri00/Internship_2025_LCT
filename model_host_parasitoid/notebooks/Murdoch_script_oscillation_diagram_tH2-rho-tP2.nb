           UnderoverscriptBox["\[Sum]", 
            RowBox[{"i", "=", "1"}], "mm"], 
           RowBox[{
            RowBox[{"P", "[", "i", "]"}], "[", "t", "]"}]}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"fH", " ", "=", " ", 
          RowBox[{"\[Theta]H", " ", "/", " ", 
           RowBox[{"(", 
            RowBox[{"\[Theta]H", " ", "+", " ", "\[Delta]H1"}], ")"}]}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"fP", " ", "=", " ", 
          RowBox[{"\[Theta]P", " ", "/", " ", 
           RowBox[{"(", 
            RowBox[{"\[Theta]P", " ", "+", " ", "\[Delta]P1"}], ")"}]}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"P2eqpredi", " ", "=", " ", 
          RowBox[{
           RowBox[{"\[Theta]H", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"fH", " ", "*", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"r", "/", "\[Delta]H2"}], ")"}], "^", 
