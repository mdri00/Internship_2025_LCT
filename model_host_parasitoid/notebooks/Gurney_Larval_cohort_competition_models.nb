 CellLabel->
  "Out[155]=",ExpressionUUID->"b6794033-47d1-4788-806b-c82b6d1737c2"]
}, Open  ]],

Cell[TextData[{
 "Cela revient \[AGrave] v\[EAcute]rifier que",
 StyleBox[" ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   FractionBox["\[Delta]j", "\[Delta]a"], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"38788acc-1a57-48fd-afd1-ff9297caa692"],
 " ",
 StyleBox["< ln(\[Rho])(ln(\[Rho])-1)(ln(\[Rho])-2))\n",
  FontWeight->"Bold"],
 "-> On imagine mieux pourquoi augmenter \[EAcute]crire \[Delta]j = 0 \
augmente \[EAcute]norm\[EAcute]ment la taille de la patate : ici cela \
voudrait dire que la patate existe toujours tant que \[Rho] > 1( certes \
\[CCedilla]a ne donne pas d\[CloseCurlyQuote]info sur sa taille)\n-> On voit \
aussi comme le terme de gauche est > 0 que on doit avoir ln(\[Rho])>2 ie",
 StyleBox[" q > \[ExponentialE]^2 \[Delta]a ",
  FontWeight->"Bold"],
 "soit environ 7.4 \[Delta]a"
}], "Text",
 CellChangeTimes->{{3.9572629495915813`*^9, 3.957263125665689*^9}, {
  3.957263258779331*^9, 3.9572632645999126`*^9}, {3.957263385981584*^9, 
  3.957263467559209*^9}},ExpressionUUID->"0987e083-d260-4d7a-bb8f-\
ff2d9d3dc251"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[ExponentialE]", "^", "2"}], "//", "N"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.957263453185801*^9, 3.957263456607189*^9}},
 CellLabel->
  "In[156]:=",ExpressionUUID->"ea7c2445-19f1-4e17-b427-b1908b13d706"],

