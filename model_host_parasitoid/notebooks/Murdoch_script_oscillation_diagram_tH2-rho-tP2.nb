                    RowBox[{"AppendTo", "[", 
                    RowBox[{"Data", ",", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    "tH2val", ",", "tP2val", ",", "0.", ",", "0.", ",", 
