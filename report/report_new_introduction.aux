\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Bifurcation diagram of the Murdoch system with parameters inspired from those in Murdoch 1987 : $\delta _{H1} = 0, \delta _{P1} = 1, \delta _{P2} = 8, \rho = 33, m_P = 2, T_{H2} = 1/\delta _{H2} = 2, T_{H1} = 1/m_H = 1$.}}{40}{}\protected@file@percent }
\newlabel{fig:bifurc_suppl}{{1}{40}{Supplementary figures}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Local stability diagram of the system around the non-trivial equilibrium for the Murdoch model, with varying developmental variabilities for host ($n$) and parasitoid ($m$). The system is unstable to the left of the curves, and stable to their right. Blue lines indicate stability boundaries for fixed delays. Black lines indicate stability boundaries for the number of LCT subcompartments $n$ and $m$ given by the grid. Parameters are $\delta _{H1} = 0, \delta _{P1} = 1, \delta _{P2} = 8, \rho = 33, T_{H1} = 1/m_H = 1$.}}{41}{}\protected@file@percent }
\newlabel{fig:murdoch_stab_n_diff_m}{{2}{41}{Supplementary figures}{figure.2}{}}
