Cell[TextData[{
 "Trouver ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Omega]", 
    RowBox[{"(", "n", ")"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2ab69dd6-2b13-4e0c-8c7f-a137758dc751"],
 "(\[Tau]) revient \[AGrave] trouver la racine d\[CloseCurlyQuote]un long \
polyn\[OHat]me de degr\[EAcute] n dans le cas d\[CloseCurlyQuote]un \
d\[EAcute]lai distribu\[EAcute], puis de calculer sa racine carr\[EAcute]e (\
\[EAcute]quations 50-53).\n",
 StyleBox["Calculons l\[AGrave] pour un \[Tau] g\[EAcute]n\[EAcute]ral",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.957258615844949*^9, 3.957258669203808*^9}, {
  3.9572587259542427`*^9, 
  3.957258778676695*^9}},ExpressionUUID->"733b84d0-69ba-4ad7-9074-\
b5a071d03262"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\[Omega]n", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"qB", "[", 
    RowBox[{"\[Nu]_", ",", " ", "\[Tau]_", ",", "n_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox["\[Nu]", 
       RowBox[{"n", "+", "1", "-", "\[Nu]"}]], "+", 
      RowBox[{
       RowBox[{"dB", "^", "2"}], 
       RowBox[{
        RowBox[{"(", 
         FractionBox["\[Tau]", 
          RowBox[{"n", "+", 
           RowBox[{"d1B", " ", "\[Tau]"}]}]], ")"}], "^", "2"}]}]}], ")"}], 
    " ", 
    RowBox[{"Binomial", "[", 
     RowBox[{"n", ",", " ", "\[Nu]"}], "]"}], " ", 
    RowBox[{
     RowBox[{"(", 
      FractionBox["\[Tau]", 
       RowBox[{"n", "+", " ", 
        RowBox[{"d1B", " ", "\[Tau]"}]}]], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{"\[Nu]", "-", "1"}], ")"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"T", "[", 
    RowBox[{"t_", ",", " ", "\[Tau]_", ",", "n_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"dB", "^", "2"}]}], " ", "*", " ", 
     RowBox[{"(", 
      RowBox[{"\[Eta]B", " ", "-", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"enB", "[", 
         RowBox[{"d1B", " ", "\[Tau]"}], "]"}], "]"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{"\[Eta]B", "-", 
       RowBox[{"Log", "[", 
        RowBox[{"enB", "[", 
         RowBox[{"d1B", " ", "\[Tau]"}], "]"}], "]"}], " ", "-", "2"}], 
      ")"}]}], " ", "+", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"qB", "[", 
        RowBox[{"\[Nu]", ",", " ", "\[Tau]", ",", "n"}], "]"}], "*", 
       RowBox[{"t", "^", "\[Nu]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Nu]", ",", " ", "1", ",", "n", ",", "1"}], "}"}]}], "]"}], 
    " ", "+", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       FractionBox["\[Tau]", 
        RowBox[{"n", "+", 
         RowBox[{"d1B", " ", "\[Tau]"}]}]], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"2", "n"}], ")"}]}], "*", 
     RowBox[{"t", "^", 
      RowBox[{"(", 
       RowBox[{"n", "+", "1"}], ")"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Omega]n", "[", 
   RowBox[{"\[Tau]_", ",", " ", "par_", ",", "ni_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"polreplaced", ",", " ", "troot", ",", " ", "\[Omega]nresult"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"polreplaced", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"T", "[", 
         RowBox[{"t", ",", "\[Tau]", ",", "ni"}], "]"}], "/.", "par"}], "/.", 
       RowBox[{"n", "->", "ni"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"troot", " ", "=", " ", 
      RowBox[{"t", "/.", 
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{"polreplaced", " ", "==", " ", "0"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0.01"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Omega]nresult", " ", "=", " ", 
      RowBox[{"Sqrt", "[", "troot", "]"}]}], ";", "\[IndentingNewLine]", 
     "\[Omega]nresult"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"\[Omega]n", "[", 
  RowBox[{"5", ",", " ", "parBeretta", ",", "10"}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.957256915209383*^9, 3.957256959623763*^9}, {
  3.957257072395651*^9, 3.957257144751286*^9}, {3.957257263441811*^9, 
