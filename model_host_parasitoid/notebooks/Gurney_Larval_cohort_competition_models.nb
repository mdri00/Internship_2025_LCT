Cell[TextData[{
 "Calculons ainsi la fonction ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Phi]", 
    RowBox[{"(", "n", ")"}]], TraditionalForm]],ExpressionUUID->
  "f736c01c-a536-4045-b7ea-807de5484d2f"],
 "(\[Tau]) qui devra traverser des multiples impairs strictement positifs de \
\[Pi] pour l\[CloseCurlyQuote]existence d\[CloseCurlyQuote]une zone d\
\[CloseCurlyQuote]instabilit\[EAcute]."
}], "Text",
 CellChangeTimes->{{3.957258674149271*^9, 3.9572587060009823`*^9}, {
  3.957262713221263*^9, 
  3.9572627262251053`*^9}},ExpressionUUID->"b6d98293-1ac4-4eef-83ff-\
d13dc78cabf8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Phi]", "[", 
     RowBox[{"\[Tau]_", ",", " ", "par_", ",", " ", "ni_"}], "]"}], " ", ":=",
     " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"ni", " ", 
        RowBox[{"ArcTan", "[", 
         FractionBox[
          RowBox[{
           RowBox[{"\[Omega]n", "[", 
            RowBox[{"\[Tau]", ",", " ", "par", ",", "ni"}], "]"}], "*", 
           "\[Tau]"}], 
          RowBox[{"ni", " ", "+", " ", 
           RowBox[{"d1B", " ", "\[Tau]"}]}]], "]"}]}], " ", "+", " ", 
       RowBox[{"ArcTan", "[", 
        FractionBox[
         RowBox[{"\[Omega]n", "[", 
          RowBox[{"\[Tau]", ",", " ", "par", ",", "ni"}], "]"}], "dB"], 
        "]"}]}], "/.", "par"}], "//", " ", "N"}]}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.957256915209383*^9, 3.957256959623763*^9}, {
   3.957257072395651*^9, 3.957257144751286*^9}, {3.957257263441811*^9, 
   3.957257395378683*^9}, {3.957257472445237*^9, 3.957257740673115*^9}, {
   3.957257784899963*^9, 3.957257789611474*^9}, 3.957258714893793*^9, {
   3.9572587464352407`*^9, 3.957258746967249*^9}, {3.957259340580049*^9, 
   3.957259390875277*^9}, {3.957259424265277*^9, 3.957259465151063*^9}, {
   3.9572597221521997`*^9, 3.957259739454867*^9}, {3.9572598068821707`*^9, 
   3.9572598093928623`*^9}, {3.957262241345845*^9, 3.9572622450927134`*^9}, {
   3.957318972991522*^9, 3.957318973932844*^9}},
 CellLabel->
  "In[102]:=",ExpressionUUID->"47e3c40e-09c3-4fdc-897b-2fba1d88500d"]
}, Open  ]],

