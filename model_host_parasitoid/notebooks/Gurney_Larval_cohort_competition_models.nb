Cell["\<\
Fusionner les deux log dans l\[CloseCurlyQuote]expression du haut montre que \
ces deux expressions sont \[EAcute]gales.\
\>", "Text",
 CellChangeTimes->{{3.957256860604106*^9, 
  3.957256884427944*^9}},ExpressionUUID->"17c97d86-a7c2-4f8b-ba9f-\
2566debff6ef"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"d1dc", " ", "//", " ", "FullSimplify"}], "\[IndentingNewLine]", 
 RowBox[{"d1d", " ", "=", " ", 
  RowBox[{
   RowBox[{"d1B", "/", "dB"}], " ", "//", "FullSimplify"}]}]}], "Input",
