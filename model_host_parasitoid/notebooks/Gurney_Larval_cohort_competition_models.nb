Cell[CellGroupData[{

Cell["Que donne Perron Frobenius (Plemmons 1977)?", "Subsection",
 CellChangeTimes->{{3.954834659840757*^9, 
  3.9548346759351177`*^9}},ExpressionUUID->"fa22496d-4cf8-4a48-b05f-\
1302fbae22d4"],

Cell[TextData[{
 "On utilise N39 => J29 (Si N39 est vraie, J29: parties r\[EAcute]elles de \
chaque valeur propre de -Jacobienne positive, donc n\[EAcute]gatives pour \
+Jacobienne, donc \[EAcute]quilibre non trivial stable) \nN39 revient \
\[AGrave] un syst\[EGrave]me de n in\[EAcute]galit\[EAcute]s. Il correspond \
\[AGrave] trouver x,y dans R*+ tq :\n\t-",
 Cell[BoxData[
  FormBox[
   RowBox[{"Jac", "(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]],ExpressionUUID->
  "12f244f4-2a82-4762-b3d9-1f5e2c3a82bd"],
 ">Abs(-Jac(1,2))\n\t-Jac(2,2)>Abs(-Jac(2,1))\nDonc ici ce syst\[EGrave]me \
\[EAcute]quivaut \[AGrave]:"
}], "Text",
 CellChangeTimes->{{3.954834680843672*^9, 3.9548346874494543`*^9}, {
  3.95483472546986*^9, 3.954834865207103*^9}, {3.954834906680335*^9, 
  3.954834932193303*^9}},ExpressionUUID->"3d322f04-2cd4-45dc-8eb8-\
f1c7edf4a515"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PFcond", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"lJODE", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ">", 
     RowBox[{"lJODE", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", " ", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"lJODE", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ">", 
     RowBox[{"lJODE", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "1"}], "]"}], "]"}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.954834875639956*^9, 3.95483490012*^9}, {
  3.9548349358553953`*^9, 3.954834937981205*^9}},
 CellLabel->
  "In[486]:=",ExpressionUUID->"27ffcd37-3c64-4bf8-b321-84b86c30b7bf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Delta]j", "+", 
     FractionBox["1", "\[Tau]1"]}], ">", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"A", "[", "t", "]"}], "A0"]}]], " ", "q"}], "-", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"A", "[", "t", "]"}], "A0"]}]], " ", "q", " ", 
       RowBox[{"A", "[", "t", "]"}]}], "A0"]}]}], ",", 
   RowBox[{"\[Delta]a", ">", 
    FractionBox["1", "\[Tau]1"]}]}], "}"}]], "Output",
 CellChangeTimes->{3.95483490037213*^9, 3.9548349391813*^9},
 CellLabel->
  "Out[486]=",ExpressionUUID->"278e74dc-104b-4b6e-8293-941db3af1a6b"]
}, Open  ]],

