774c0c721b0b"],

Cell[" (\[EAcute]quilibre stable ou min et max des cycles limites stables)", \
"Text",
 CellChangeTimes->{
  3.953366717918721*^9},ExpressionUUID->"6317d3e7-31ea-45f3-ae36-\
7de90f8caf37"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"paramsplot", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"mH", "->", "1"}], ",", 
     RowBox[{"\[Rho]", " ", "->", " ", "33"}], ",", 
     RowBox[{"\[Delta]H1", "->", "0"}], ",", 
     RowBox[{"\[Delta]H2", "->", 
      RowBox[{"1", "/", 
       RowBox[{"(", "0.25", ")"}]}]}], ",", " ", 
     RowBox[{"mP", "->", 
      RowBox[{"1", "/", 
       RowBox[{"(", "2", ")"}]}]}], ",", 
     RowBox[{"\[Delta]P2", "->", "8"}], ",", " ", 
     RowBox[{"\[Delta]P1", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"a", "->", " ", "1"}]}], "}"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"nmValues", "=", 
     RowBox[{"{", "50", "}"}]}], ";"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmax", " ", "=", " ", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ComputingStatus", " ", "=", " ", "\"\<Setup\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"paramInfo", "=", 
   RowBox[{"StringJoin", "[", "\[IndentingNewLine]", 
    RowBox[{"\"\<tH2_\>\"", ",", 
     RowBox[{"ToString", "[", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"\[Delta]H2", "/.", "paramsplot"}], " ", ")"}]}], "//", 
       "N"}], "]"}], ",", "\[IndentingNewLine]", "\"\<_tP1_\>\"", ",", 
     RowBox[{"ToString", "[", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"mP", "/.", "paramsplot"}], " ", ")"}]}], "//", "N"}], "]"}],
      ",", "\[IndentingNewLine]", "\"\<_rho_\>\"", ",", 
     RowBox[{"ToString", "[", 
      RowBox[{"\[Rho]", "/.", "paramsplot"}], " ", "]"}], ",", 
     "\[IndentingNewLine]", "\"\<_dP2_\>\"", ",", 
     RowBox[{"ToString", "[", 
      RowBox[{"\[Delta]P2", "/.", "paramsplot"}], " ", "]"}], ",", 
     "\[IndentingNewLine]", "\"\<_dH1_\>\"", ",", 
     RowBox[{"ToString", "[", 
      RowBox[{"\[Delta]H1", "/.", "paramsplot"}], " ", "]"}], ",", 
     "\[IndentingNewLine]", "\"\<_dP1_\>\"", ",", 
     RowBox[{"ToString", "[", 
      RowBox[{"\[Delta]P1", "/.", "paramsplot"}], " ", "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Folder", "=", 
    RowBox[{"\"\<Murdoch_bifurcation_\>\"", "<>", "paramInfo"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"CreateDirectory", "[", "Folder", "]"}], ";"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Storage", " ", "for", " ", "results"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bifurcationData", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bifurcationDataDescriptor", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
     "\"\<n\>\"", ",", "\"\<m\>\"", ",", "\"\<eq or min or max\>\"", ",", 
      " ", "\"\<stability type\>\"", ",", " ", 
      "\"\<time between two peaks\>\""}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Loop", " ", "through", " ", "parameter", " ", "values"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"For", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"i", "=", "1"}], ",", 
     RowBox[{"i", "<=", 
      RowBox[{"Length", "[", "nmValues", "]"}]}], ",", 
     RowBox[{"i", "++"}], ",", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"currentN", "=", 
