  3.957262916094717*^9, 3.957262939989196*^9}},
 CellLabel->
  "In[154]:=",ExpressionUUID->"8da44842-ac10-4435-83c7-f1dffd67d705"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "2"}], "+", 
    RowBox[{"Log", "[", 
     FractionBox["q", "\[Delta]a"], "]"}]}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    RowBox[{"Log", "[", 
     FractionBox["q", "\[Delta]a"], "]"}]}], ")"}], " ", 
  RowBox[{"Log", "[", 
   FractionBox["q", "\[Delta]a"], "]"}]}]], "Output",
