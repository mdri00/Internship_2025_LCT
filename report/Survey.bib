	file = {PDF:/home/mathisdr/Zotero/storage/4966G6AT/Bentz et al. - 1991 - TEMPERATURE-DEPENDENT DEVELOPMENT OF THE MOUNTAIN PINE BEETLE (COLEOPTERA SCOLYTIDAE) AND SIMULATIO.pdf:application/pdf},
}

