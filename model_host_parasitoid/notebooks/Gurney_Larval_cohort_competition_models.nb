Cell["\<\
V\[EAcute]rifions les pr\[EAcute]dictions obtenues avec l\[CloseCurlyQuote]\
\[EAcute]tude analytique. Utilisons le syst\[EGrave]me minimal car autrement \
il y a de l\[CloseCurlyQuote]instabilit\[EAcute] num\[EAcute]rique et donne \
des choses bizarres.\
\>", "Text",
 CellChangeTimes->{{3.9556102706852913`*^9, 3.955610284513146*^9}, {
  3.9557887434505157`*^9, 
  3.9557887656800117`*^9}},ExpressionUUID->"7dbf077c-f400-470b-b1d3-\
9fd1251b7482"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"systemMin", "=", " ", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"A", "'"}], "[", "t", "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"q", " ", 
       RowBox[{"A", "[", 
        RowBox[{"t", "-", "\[Tau]1"}], "]"}], 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"A", "[", 
           RowBox[{"t", "-", "\[Tau]1"}], "]"}]}], "/", "A0"}], "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Delta]j"}], " ", "\[Tau]1"}], "]"}]}], "  ", "-", 
      " ", 
      RowBox[{"\[Delta]a", " ", 
       RowBox[{"A", "[", "t", "]"}]}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmax", " ", "=", " ", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"positions", "=", 
  RowBox[{"{", 
   RowBox[{"AnnTriDDE", ",", " ", "A0"}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"minMax", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "tmax"}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.955611915508559*^9, 3.95561194806918*^9}, {
   3.955612194933319*^9, 3.955612215013492*^9}, {3.955612356253635*^9, 
   3.955612389884849*^9}, {3.9556124657667933`*^9, 3.955612468174841*^9}, {
   3.955612752928665*^9, 3.955612753541984*^9}, {3.955613146329817*^9, 
   3.955613148445601*^9}, {3.955614044429923*^9, 3.95561404636242*^9}, {
   3.955788738633294*^9, 3.955788740374199*^9}, {3.955788863314238*^9, 
   3.955788868203003*^9}, {3.955788938553945*^9, 3.955788938890655*^9}, {
   3.955789044873026*^9, 3.955789045922475*^9}, 3.955789089797616*^9, {
   3.955789201812468*^9, 3.955789211899948*^9}},
