Cell[TextData[{
 "NB : Pour s\[CloseCurlyQuote]y retrouver par rapport \[AGrave] l\
\[CloseCurlyQuote]autre type de diagramme o\[UGrave] \[Tau]1 est en ordonn\
\[EAcute]e : ici la ligne rouge  affich\[EAcute]e correspond \[AGrave] la \
ligne rouge dans le graph plus bas.\n",
 StyleBox["\[Delta]j non nul a un peu augment\[EAcute] la zone de stabilit\
\[EAcute].",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.9562139076259108`*^9, 3.956213927317588*^9}, {
  3.956214306895234*^9, 3.956214349633191*^9}, {3.956214395249915*^9, 
