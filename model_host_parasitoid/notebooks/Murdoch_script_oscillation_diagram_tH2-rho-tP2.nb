Cell[BoxData[{
 RowBox[{"nmValues", "=", 
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"3", ",", "2"}], "}"}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "<=", 
       RowBox[{"Length", "[", "nmValues", "]"}]}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"currentN", "=", 
           RowBox[{"nmValues", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ",", 
          RowBox[{"currentM", "=", 
           RowBox[{"nmValues", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "Set", " ", "up", " ", "the", " ", "system", " ", "with", " ", 
           "current", " ", "n"}], "=", 
          RowBox[{"m", " ", "value"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"nn", "=", "currentN"}], ";", "\[IndentingNewLine]", 
         RowBox[{"mm", "=", "currentM"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"nn", ",", "mm"}], "]"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"paramInfo", "=", 
          RowBox[{"StringJoin", "[", "\[IndentingNewLine]", 
           RowBox[{"\"\<n_\>\"", ",", 
            RowBox[{"ToString", "[", "nn", "]"}], ",", "\[IndentingNewLine]", 
            "\"\<_m_\>\"", ",", 
            RowBox[{"ToString", "[", "mm", "]"}], ",", "\[IndentingNewLine]", 
            "\"\<_mP_\>\"", ",", 
            RowBox[{"ToString", "[", 
             RowBox[{"mP", "/.", "paramsplot"}], "]"}], ",", 
            "\[IndentingNewLine]", "\"\<_dP1_\>\"", ",", 
            RowBox[{"ToString", "[", 
             RowBox[{"\[Delta]P1", "/.", "paramsplot"}], "]"}], ",", 
            "\[IndentingNewLine]", "\"\<_dH1_\>\"", ",", 
            RowBox[{"ToString", "[", 
             RowBox[{"\[Delta]H1", "/.", "paramsplot"}], "]"}]}], 
           "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Folder", "=", 
          RowBox[{"\"\<Data_stability_tH2dP2_\>\"", "<>", "paramInfo"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"CreateDirectory", "[", "Folder", "]"}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"DataDescriptor", " ", "=", " ", 
