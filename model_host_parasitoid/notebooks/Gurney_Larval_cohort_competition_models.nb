Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Declare", "[", 
   RowBox[{"J", ",", "A", ",", "Real"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"systemODE", " ", "=", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"J", "'"}], "[", "t", "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"q", " ", 
       RowBox[{"A", "[", "t", "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"A", "[", "t", "]"}]}], "/", "A0"}], "]"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"J", "[", "t", "]"}], "/", "\[Tau]1"}], " ", "-", " ", 
      RowBox[{"\[Delta]j", " ", 
       RowBox[{"J", "[", "t", "]"}]}]}]}], ",", " ", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"A", "'"}], "[", "t", "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"J", "[", "t", "]"}], "/", "\[Tau]1"}], " ", "-", " ", 
      RowBox[{"\[Delta]a", " ", 
       RowBox[{"A", "[", "t", "]"}]}]}]}]}], "}"}]}]}], "Input",
