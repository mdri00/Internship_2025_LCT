     RowBox[{"3", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A0q", "=", "600"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"par", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"q", "->", "qq"}], ",", 
     RowBox[{"\[Delta]a", " ", "->", "\[Delta]aq"}], ",", " ", 
     RowBox[{"\[Delta]j", " ", "->", " ", "\[Delta]jq"}], ",", " ", 
     RowBox[{"\[Tau]1", "->", "\[Tau]1q"}], ",", " ", 
     RowBox[{"A0", "->", "A0q"}]}], "}"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"leqnIC", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"{", 
     RowBox[{"systemMin", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "A0q"}], "}"}]}], "}"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"leqnIC", "/.", " ", "par"}], ",", 
     RowBox[{"{", "A", "}"}], ",", 
     RowBox[{"{", 
