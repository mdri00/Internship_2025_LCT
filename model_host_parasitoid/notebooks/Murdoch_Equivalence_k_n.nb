Cell[CellGroupData[{

Cell["Focus sur les solutions avec R\[EAcute]el Nul", "Subsection",
 CellChangeTimes->{
  3.955168037647849*^9},ExpressionUUID->"ce484d67-994f-4d5a-ab72-\
0cb22554d346"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"parPI", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[Tau]1", "\[Rule]", "1"}], ",", 
    RowBox[{"\[Delta]H1", "\[Rule]", "0"}], ",", 
    RowBox[{"\[Delta]P1", "\[Rule]", "1"}], ",", 
    RowBox[{"a", "\[Rule]", "1"}], ",", 
    RowBox[{"\[Delta]P2", "\[Rule]", "8"}], ",", 
    RowBox[{"\[Rho]", "\[Rule]", "33"}], ",", 
    RowBox[{"k", "\[Rule]", "100000"}]}], "}"}]}], "\n", 
 RowBox[{
  RowBox[{"reel", "=", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"Re", "[", 
     RowBox[{
      RowBox[{"EqCaraPI", "/.", 
       RowBox[{"{", 
        RowBox[{"s", "\[Rule]", 
         RowBox[{"x", " ", "I"}]}], "}"}]}], "/.", "parPI"}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"imag", "=", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"Im", "[", 
     RowBox[{
      RowBox[{"EqCaraPI", "/.", 
       RowBox[{"{", 
        RowBox[{"s", "\[Rule]", 
         RowBox[{"x", " ", "I"}]}], "}"}]}], "/.", "parPI"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xtempo", " ", "=", " ", "2.12"}], ";"}], "\[IndentingNewLine]", 
