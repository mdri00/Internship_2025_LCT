parasito\[IDoubleDot]des\nParam\[EAcute]trage instantan\[EAcute] type \
\[OpenCurlyDoubleQuote]\[Theta] = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "*", 
    SubscriptBox["m", "X"]}], TraditionalForm]],ExpressionUUID->
  "c1ead813-2fb8-40e1-8a86-56454f336eb9"],
 "\[CloseCurlyDoubleQuote]\n",
 "\[CapitalPi](t) = k ",
