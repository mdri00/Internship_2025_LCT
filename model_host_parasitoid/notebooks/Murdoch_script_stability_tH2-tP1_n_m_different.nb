Cell[BoxData[{
 RowBox[{
  RowBox[{"paramInfo", "=", 
   RowBox[{"StringJoin", "[", 
    RowBox[{"\"\<rho_\>\"", ",", 
     RowBox[{"ToString", "[", 
      RowBox[{"\[Rho]", "/.", "paramsplot"}], "]"}], ",", 
     "\[IndentingNewLine]", "\"\<_dH1_\>\"", ",", 
     RowBox[{"ToString", "[", 
