        RowBox[{"lJ", " ", "=", " ", 
         RowBox[{"CreateMatrix", "[", 
          RowBox[{"nn", ",", "mm"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"vars", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{
