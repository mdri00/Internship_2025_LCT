Cell[CellGroupData[{

Cell["\<\
Comparaison dynamiques dans la patate (\[Delta]j = 0.07) selon la variabilit\
\[EAcute] d\[EAcute]veloppementale\
\>", "Section",
 CellChangeTimes->{{3.918710122486343*^9, 3.918710126286147*^9}, {
  3.95621251897785*^9, 3.956212534329514*^9}, {3.956217358876596*^9, 
  3.956217364424862*^9}},ExpressionUUID->"a07e3b5b-22d2-4a45-8175-\
d580b429005d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tmax", " ", "=", " ", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"parInstable", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Delta]a", "->", "0.15"}], ",", " ", 
      RowBox[{"\[Tau]1", "->", "12"}], ",", " ", 
      RowBox[{"q", "->", "8.5"}], ",", " ", 
      RowBox[{"A0", "->", "600"}], ",", " ", 
      RowBox[{"\[Delta]j", "->", "0.07"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"leqnICLCT", " ", "=", " ", 
    RowBox[{"Flatten", "[", 
     RowBox[{"{", 
      RowBox[{"systemLCT", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"J", "[", "1", "]"}], "[", "0", "]"}], " ", "==", " ", 
          "100"}], ",", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"J", "[", "i", "]"}], "[", "0", "]"}], " ", "==", " ", 
            "100"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "2", ",", "nn"}], "}"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"A", "[", "0", "]"}], " ", "==", " ", "A0"}], "/.", 
          "parInstable"}]}], "}"}]}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"systemMinDDE", "=", " ", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"A", "'"}], "[", "t", "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"q", " ", 
       RowBox[{"A", "[", 
        RowBox[{"t", "-", "\[Tau]1"}], "]"}], 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"A", "[", 
           RowBox[{"t", "-", "\[Tau]1"}], "]"}]}], "/", "A0"}], "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Delta]j"}], " ", "\[Tau]1"}], "]"}]}], "  ", "-", 
      " ", 
      RowBox[{"\[Delta]a", " ", 
       RowBox[{"A", "[", "t", "]"}]}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"leqnICDDE", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{"{", 
      RowBox[{"systemMinDDE", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"A", "[", 
           RowBox[{"t", "/;", 
            RowBox[{"t", "<=", "0"}]}], "]"}], "==", "A0"}], "/.", 
         "parInstable"}], "}"}]}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"systemODE", " ", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Jode", "'"}], "[", "t", "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"q", " ", 
        RowBox[{"A", "[", "t", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"A", "[", "t", "]"}]}], "/", "A0"}], "]"}]}], " ", "-", 
       " ", 
       RowBox[{
        RowBox[{"Jode", "[", "t", "]"}], "/", "\[Tau]1"}], " ", "-", " ", 
       RowBox[{"\[Delta]j", " ", 
        RowBox[{"Jode", "[", "t", "]"}]}]}]}], ",", " ", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"A", "'"}], "[", "t", "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Jode", "[", "t", "]"}], "/", "\[Tau]1"}], " ", "-", " ", 
       RowBox[{"\[Delta]a", " ", 
        RowBox[{"A", "[", "t", "]"}]}]}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"leqnICODE", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{"{", 
     RowBox[{"systemODE", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Jode", "[", "0", "]"}], " ", "==", " ", "10"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"A", "[", "0", "]"}], " ", "==", " ", "A0"}], "/.", 
         "parInstable"}]}], "}"}]}], "}"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9562125428757057`*^9, 3.9562125516311398`*^9}, {
  3.9562125895125303`*^9, 3.9562126508203773`*^9}, {3.956212717434197*^9, 
  3.95621287377356*^9}},
 CellLabel->
  "In[401]:=",ExpressionUUID->"830a7666-ab3f-4475-8823-c9c2070dc104"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"solDDE", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"leqnICDDE", "/.", " ", "parInstable"}], ",", 
     RowBox[{"{", "A", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solODE", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"leqnICODE", "/.", " ", "parInstable"}], ",", 
     RowBox[{"{", 
      RowBox[{"Jode", ",", "A"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solLCT", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"leqnICLCT", "/.", "parInstable"}], "/.", 
      RowBox[{"n", "->", "nn"}]}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"J", "[", "1", "]"}], ",", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"J", "[", "i", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "2", ",", "nn"}], "}"}]}], "]"}], ",", "A"}], 
       "}"}], "//", "Flatten"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", "tmax"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.956212845614626*^9, 3.956212919786948*^9}},
 CellLabel->
  "In[408]:=",ExpressionUUID->"ffa36c5f-2eda-47d5-af4a-09d13f9e2c2f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"A", "[", "t", "]"}], "/.", 
        RowBox[{"solDDE", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "//", "Evaluate"}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"A", "[", "t", "]"}], "/.", 
        RowBox[{"solODE", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "//", "Evaluate"}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"A", "[", "t", "]"}], "/.", 
        RowBox[{"solLCT", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "//", "Evaluate"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tmax", "-", "100"}], ",", " ", "tmax"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "5000"}], "}"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<DDE\>\"", ",", " ", "\"\<ODE\>\"", ",", " ", 
       RowBox[{"\"\<LCT n = \>\"", "<>", 
        RowBox[{"ToString", "[", "nn", "]"}]}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<t\>\"", ",", " ", "\"\<A\>\""}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]"}]], "Input",
