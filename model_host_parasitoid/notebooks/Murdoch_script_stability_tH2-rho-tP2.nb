Cell[CellGroupData[{

Cell["Graphes tH2-tP2", "Chapter",
 CellChangeTimes->{{3.950950538831592*^9, 
  3.950950542174708*^9}},ExpressionUUID->"c6569d49-7db9-43a8-a2e0-\
c587a6452c67"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"paramInfo", "=", 
   RowBox[{"StringJoin", "[", 
    RowBox[{"\"\<mP_\>\"", ",", 
     RowBox[{"ToString", "[", 
      RowBox[{"mP", "/.", "paramsplot"}], "]"}], ",", "\[IndentingNewLine]", 
     "\"\<_dP1_\>\"", ",", 
     RowBox[{"ToString", "[", 
      RowBox[{"\[Delta]P1", "/.", "paramsplot"}], "]"}], ",", 
     "\[IndentingNewLine]", "\"\<_dH1_\>\"", ",", 
     RowBox[{"ToString", "[", 
      RowBox[{"\[Delta]H1", "/.", "paramsplot"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Folder", "=", 
    RowBox[{"\"\<Murdoch_stability_tH2-dP2_\>\"", "<>", "paramInfo"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"CreateDirectory", "[", "Folder", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Storage", " ", "for", " ", "results"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"StabilityCurveData", "=", 
    RowBox[{"{", "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Loop", " ", "through", " ", "parameter", " ", "values"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"For", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"i", "=", "1"}], ",", 
     RowBox[{"i", "<=", 
      RowBox[{"Length", "[", "nmValues", "]"}]}], ",", 
     RowBox[{"i", "++"}], ",", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"currentN", "=", 
          RowBox[{"nmValues", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ",", 
         RowBox[{"currentM", "=", 
          RowBox[{"nmValues", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Set", " ", "up", " ", "the", " ", "system", " ", "with", " ", 
          "current", " ", "n"}], "=", 
         RowBox[{"m", " ", "value"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"nn", "=", "currentN"}], ";", "\[IndentingNewLine]", 
        RowBox[{"mm", "=", "currentM"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"H1", "[", "t", "]"}], "=", " ", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"i", "=", "1"}], "nn"], 
          RowBox[{
           RowBox[{"H", "[", "i", "]"}], "[", "t", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"P1", "[", "t", "]"}], "=", " ", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"i", "=", "1"}], "mm"], 
          RowBox[{
           RowBox[{"P", "[", "i", "]"}], "[", "t", "]"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"fH", " ", "=", " ", 
         RowBox[{"\[Theta]H", " ", "/", " ", 
          RowBox[{"(", 
           RowBox[{"\[Theta]H", " ", "+", " ", "\[Delta]H1"}], ")"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"fP", " ", "=", " ", 
         RowBox[{"\[Theta]P", " ", "/", " ", 
          RowBox[{"(", 
           RowBox[{"\[Theta]P", " ", "+", " ", "\[Delta]P1"}], ")"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"P2eqpredi", " ", "=", " ", 
         RowBox[{
          RowBox[{"\[Theta]H", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"fH", " ", "*", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"r", "/", "\[Delta]H2"}], ")"}], "^", 
                RowBox[{"(", 
                 RowBox[{"1", "/", "n"}], ")"}]}]}], " ", "-", " ", "1"}], 
             ")"}], "/", 
            RowBox[{"(", 
             RowBox[{"a", " ", "fH"}], ")"}]}]}], " ", "//", " ", 
          "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sH", " ", "=", " ", 
         RowBox[{"\[Theta]H", " ", "/", " ", 
          RowBox[{"(", 
           RowBox[{"\[Theta]H", " ", "+", " ", "\[Delta]H1", " ", "+", " ", 
            RowBox[{"a", " ", "P2eqpredi"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Alpha]H", " ", "=", " ", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"i", "=", "0"}], 
           RowBox[{"n", "-", "1"}]], 
          RowBox[{
           RowBox[{"(", "sH", ")"}], "^", "i"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Alpha]P", " ", "=", " ", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"i", "=", "0"}], 
           RowBox[{"m", "-", "1"}]], 
          RowBox[{"fP", "^", "i"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"H1eqpredi", " ", "=", " ", 
         RowBox[{"\[Delta]P2", "/", 
          RowBox[{"(", 
           RowBox[{"a", "*", 
            RowBox[{"fP", "^", "m"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"H2eqpredi", " ", "=", " ", 
         RowBox[{
          RowBox[{"H1eqpredi", " ", "*", " ", "\[Theta]H", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"r", "/", "\[Delta]H2"}], ")"}], "^", 
               RowBox[{"(", 
                RowBox[{"1", "/", "n"}], ")"}]}], "-", "1"}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{"\[Delta]H2", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"r", "/", "\[Delta]H2"}], ")"}], "-", "1"}], ")"}]}],
              ")"}]}]}], " ", "//", " ", "FullSimplify"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"P1eqpredi", " ", "=", " ", 
         RowBox[{
          RowBox[{"P2eqpredi", " ", "*", " ", "\[Alpha]P", " ", "*", " ", 
           RowBox[{"\[Delta]P2", " ", "/", 
            RowBox[{"(", 
             RowBox[{"\[Theta]P", "*", 
              RowBox[{"fP", "^", 
               RowBox[{"(", 
                RowBox[{"m", "-", "1"}], ")"}]}]}], ")"}]}]}], " ", "//", " ",
           "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"lJ", " ", "=", " ", 
         RowBox[{"CreateMatrix", "[", 
          RowBox[{"nn", ",", "mm"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"vars", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"H", "[", "i", "]"}], "[", "t", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", "nn"}], "}"}]}], "]"}], ",", 
            RowBox[{"H2", "[", "t", "]"}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"P", "[", "i", "]"}], "[", "t", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", "mm"}], "}"}]}], "]"}], ",", " ", 
            RowBox[{"P2", "[", "t", "]"}]}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"varseq", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"H1eqpredi", "/", "\[Alpha]H"}], ")"}], " ", 
               RowBox[{"sH", "^", 
                RowBox[{"(", 
                 RowBox[{"i", "-", "1"}], ")"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", "nn"}], "}"}]}], "]"}], ",", 
            "H2eqpredi", ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"P1eqpredi", "/", "\[Alpha]P"}], ")"}], " ", 
               RowBox[{"fP", "^", 
                RowBox[{"(", 
                 RowBox[{"i", "-", "1"}], ")"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", "mm"}], "}"}]}], "]"}], ",", " ", 
            "P2eqpredi"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"lJeq", "=", 
         RowBox[{"lJ", " ", "/.", "\[IndentingNewLine]", 
          RowBox[{"Thread", "[", 
           RowBox[{"vars", "->", "varseq"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"\[Theta]H", " ", "=", " ", 
         RowBox[{"n", "*", "mH"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Theta]P", " ", "=", " ", 
         RowBox[{"m", "*", "mP"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{"\[Rho]", "*", "\[Delta]H2"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"Clear", "[", "\[Delta]H1", "]"}], ";", " ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "On", " ", "utilise", " ", "les", " ", "mortalit\[EAcute]s", " ", 
          "intrins\[EGrave]ques", " ", "telles", " ", "quelles"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"Clear", "[", "\[Delta]P1", "]"}], ";", "\[IndentingNewLine]",
         "\[IndentingNewLine]", 
        RowBox[{"\[Tau]2Min", "=", "0.01"}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Tau]2Max", "=", "1"}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Tau]2Pas", "=", "0.02"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"CourbeLimite", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tP2Min", "=", "0.01"}], ";", 
        RowBox[{"tP2Max", "=", "5"}], ";", 
        RowBox[{"tP2Pas", "=", "0.05"}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"tP2", "=", "tP2Min"}], ",", 
          RowBox[{"tP2", "<", "tP2Max"}], ",", 
          RowBox[{"tP2", "+=", "tP2Pas"}], ",", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"tsol", "=", 
            RowBox[{"tH2", "/.", " ", 
             RowBox[{"FindRoot", "[", 
              RowBox[{
               RowBox[{"VPdP2", "[", 
                RowBox[{"tH2", ",", "tP2"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"tH2", ",", "0.01", ",", "10"}], "}"}], ",", 
               RowBox[{"Method", "->", "\"\<Brent\>\""}]}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"CourbeLimite", ",", 
             RowBox[{"{", 
              RowBox[{"tsol", ",", "tP2"}], "}"}]}], "]"}]}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"StabilityCurveData", ",", " ", "CourbeLimite"}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", 
     RowBox[{"Length", "[", "nmValues", "]"}]}], "}"}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"Folder", ",", "\"\<nmRange.csv\>\""}], "}"}], "]"}], ",", 
    "nmValues"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"Folder", ",", "\"\<parameters.csv\>\""}], "}"}], "]"}], ",", 
    "paramsplot"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"Folder", ",", "\"\<data.csv\>\""}], "}"}], "]"}], ",", 
    "StabilityCurveData"}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.953868260101926*^9, 3.9538684317902203`*^9}, {
