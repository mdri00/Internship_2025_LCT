Cell["Technique de r\[EAcute]solution avec solution imaginaire pure (?)", \
"Subsection",
 CellChangeTimes->{{3.955433476464917*^9, 
  3.955433489970161*^9}},ExpressionUUID->"cdde990b-c4d5-4881-aa68-\
6ad0ee534440"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"reelbis", "=", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"Re", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"EqCaraPI", "/.", "\[Tau]2replace"}], "/.", 
       RowBox[{"{", 
        RowBox[{"s", "\[Rule]", 
         RowBox[{"x", " ", "I"}]}], "}"}]}], "/.", "parPIbis"}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"imagbis", "=", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"Im", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"EqCaraPI", "/.", "\[Tau]2replace"}], "/.", 
       RowBox[{"{", 
        RowBox[{"s", "\[Rule]", 
         RowBox[{"x", " ", "I"}]}], "}"}]}], "/.", "parPIbis"}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xtempo", " ", "=", " ", "2.12"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tratiotempo", " ", "=", " ", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VPthierrybis", "[", "kval_", "]"}], " ", ":=", " ", 
  RowBox[{"tRatio", "/.", 
   RowBox[{"FindRoot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"reelbis", ",", "imagbis"}], "}"}], "/.", 
      RowBox[{"{", 
       RowBox[{"k", "->", "kval"}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "xtempo"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"tRatio", ",", "tratiotempo"}], "}"}]}], "]"}]}]}], "\n", 
 RowBox[{"ListPlot", "[", 
