         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "\[Rho]"}], ")"}], " ", 
         RowBox[{"Log", "[", 
          SuperscriptBox["\[ExponentialE]", 
           FractionBox[
            RowBox[{
             RowBox[{
              RowBox[{"-", "\[Delta]H1"}], " ", "\[Tau]1"}], "+", 
             RowBox[{"Log", "[", "\[Rho]", "]"}]}], 
            RowBox[{"k", " ", "\[Tau]1"}]]], "]"}]}]]}], ")"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "s"}], "+", 
       FractionBox[
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "\[Tau]1"}], " ", 
            RowBox[{"(", 
             RowBox[{"s", "+", "\[Delta]H1", "+", 
              RowBox[{"k", " ", 
               RowBox[{"Log", "[", 
                SuperscriptBox["\[ExponentialE]", 
                 FractionBox[
                  RowBox[{
                   RowBox[{
                    RowBox[{"-", "\[Delta]H1"}], " ", "\[Tau]1"}], "+", 
                   RowBox[{"Log", "[", "\[Rho]", "]"}]}], 
                  RowBox[{"k", " ", "\[Tau]1"}]]], "]"}]}]}], ")"}]}]], " ", 
          "\[Rho]"}]}], "tH2"]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "s"}], "-", "\[Delta]H1", "-", 
       RowBox[{"k", " ", 
        RowBox[{"Log", "[", 
         SuperscriptBox["\[ExponentialE]", 
          FractionBox[
           RowBox[{
            RowBox[{
             RowBox[{"-", "\[Delta]H1"}], " ", "\[Tau]1"}], "+", 
            RowBox[{"Log", "[", "\[Rho]", "]"}]}], 
           RowBox[{"k", " ", "\[Tau]1"}]]], "]"}]}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "s"}], "-", "\[Delta]P2", "+", 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "s"}], " ", "\[Tau]2"}]], " ", "\[Delta]P2", " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{
            SuperscriptBox["\[ExponentialE]", 
             FractionBox["\[Delta]H1", "k"]], " ", 
            SuperscriptBox["\[Rho]", 
             RowBox[{"-", 
              FractionBox["1", 
               RowBox[{"k", " ", "\[Tau]1"}]]}]]}]}], ")"}]}], 
        RowBox[{"Log", "[", 
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", 
            FractionBox["\[Delta]H1", "k"]}]], " ", 
          SuperscriptBox["\[Rho]", 
           FractionBox["1", 
            RowBox[{"k", " ", "\[Tau]1"}]]]}], "]"}]]}], ")"}]}]}], 
   ")"}]}]], "Output",
 CellChangeTimes->{
  3.955419777659746*^9, {3.955419825036974*^9, 3.955419841538484*^9}},
 CellLabel->"Out[56]=",ExpressionUUID->"58c35bc1-3364-47dc-bd5e-a26c4f38ebb0"]
}, Open  ]],

Cell[TextData[{
 "Lin\[EAcute]ariser MH1(t) : \nMH1(t) = \[Rho] \[Delta]H2 (H2* + h2(t-T1)) \
exp(-",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"t", "-", "T1"}], "t"], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"k", " ", 
        RowBox[{"ln", "[", 
         RowBox[{"1", "+", 
          RowBox[{
           FractionBox["a", "k"], 
           RowBox[{"(", 
            RowBox[{"P2", "*", " ", 
             RowBox[{"+", " ", 
              RowBox[{"p2", "(", "u", ")"}]}]}], ")"}]}]}], "]"}]}], "+", 
       "\[Delta]H1"}], ")"}], 
     RowBox[{"\[DifferentialD]", "u"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cce81f39-b035-4d30-854b-22dcabd7694d"],
 ")\n-> Murdoch 1987 : mh1(t) = \[Delta]H2 h2(t-T1) - a \[Delta]H2 H2* ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"t", "-", "T1"}], "t"], 
    RowBox[{
     RowBox[{"p2", "(", "u", ")"}], 
     RowBox[{"\[DifferentialD]", "u"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f07e90f7-4bd9-4aec-8289-08e4424bd744"],
 "  + I(...)\n-> Quentin : mh1(t) = \[Rho] \[Delta]H2 exp(-T1(aP2* + \
\[Delta]H1)) [h2(t-T1) - H2*",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"t", "-", "T1"}], "t"], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"a", " ", 
        RowBox[{"p2", "(", "u", ")"}]}], "+", "\[Delta]H1"}], ")"}], 
     RowBox[{"\[DifferentialD]", "u"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f35e1b35-18de-496b-b986-3622e4b81869"],
 "]\n-> Mathis pour k-> \[Infinity] : mh1(t) = \[Rho] \[Delta]H2 \
exp(-T1(aP2*+\[Delta]H1))[h2(t-T1) - H2*",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"t", "-", "T1"}], "t"], 
    RowBox[{"a", " ", 
     RowBox[{"p2", "(", "u", ")"}], 
     RowBox[{"\[DifferentialD]", "u"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5dd16acf-80e7-42fc-b5bf-2713c5f37d58"],
 "]"
}], "Text",
 CellChangeTimes->{{3.956109525666844*^9, 3.9561097628930798`*^9}, {
  3.956109828206767*^9, 3.9561098312737417`*^9}, {3.956109897483234*^9, 
  3.956109909051937*^9}, {3.956109950895113*^9, 
  3.9561100450815363`*^9}},ExpressionUUID->"0f7cb525-fa2b-4729-821d-\
215b66124fd5"]
}, Open  ]]
