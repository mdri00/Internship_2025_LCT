Cell[CellGroupData[{

Cell["Diagramme de stabilit\[EAcute] k-tRatio (type Godfray 1989)", "Section",
 CellChangeTimes->{{3.955178689926963*^9, 3.9551787087068777`*^9}, {
  3.955432695551155*^9, 
  3.9554327163085403`*^9}},ExpressionUUID->"a4148095-debe-494a-9053-\
c2b5835bd194"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"parPIbis", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Tau]1", "\[Rule]", "1"}], ",", 
     RowBox[{"\[Delta]H1", "\[Rule]", "0"}], ",", 
     RowBox[{"\[Delta]P1", "\[Rule]", "1"}], ",", 
     RowBox[{"a", "\[Rule]", "1"}], ",", 
     RowBox[{"\[Delta]P2", "\[Rule]", "8"}], ",", 
     RowBox[{"\[Rho]", "\[Rule]", "33"}], ",", 
     RowBox[{"\[Delta]H2", "->", " ", 
      RowBox[{"1", "/", "2.5"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[Tau]2replace", " ", "=", " ", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"tRatio", " ", "==", " ", 
      FractionBox[
       RowBox[{"\[Tau]2", "+", 
        FractionBox["1", "\[Delta]P2"]}], 
       RowBox[{"\[Tau]1", "+", 
        FractionBox["1", "\[Delta]H2"]}]]}], ",", " ", "\[Tau]2"}], "]"}], 
   "[", 
   RowBox[{"[", "1", "]"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.955432873172756*^9, 3.955432985454074*^9}, {
  3.955433059005381*^9, 3.955433096337631*^9}},
 CellLabel->"In[62]:=",ExpressionUUID->"82c63148-d028-4e2d-89f3-789bdfc90a91"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\[Tau]2", "\[Rule]", 
   FractionBox[
    RowBox[{
     RowBox[{"-", "\[Delta]H2"}], "+", 
     RowBox[{"tRatio", " ", "\[Delta]P2"}], "+", 
     RowBox[{
     "tRatio", " ", "\[Delta]H2", " ", "\[Delta]P2", " ", "\[Tau]1"}]}], 
    RowBox[{"\[Delta]H2", " ", "\[Delta]P2"}]]}], "}"}]], "Output",
 CellChangeTimes->{{3.955432935173114*^9, 3.95543294503859*^9}, {
  3.9554329775754147`*^9, 3.9554329861668777`*^9}, {3.95543307458014*^9, 
  3.955433096985463*^9}},
 CellLabel->"Out[63]=",ExpressionUUID->"5dc21892-c3db-48f0-9f57-4a52abb10f60"]
}, Open  ]],

