Cell[TextData[{
 "Wearing 2004 parameters adapted for two host stages: \n\tt_H1 = 37\n\tt_H2 \
= 5\n\tl = 21\n\tdH1 = 4.25e-3\n\tdH2 = 1/t_H2\n\n\tt_P1 = 20\n\tt_P2 = 2\n\t\
dP1 = .1\n\tdP2 = 1/t_P2\n\ta = .03\n\t\n-> Rescaled by tH1 : \n\tt_H1 = ",
 StyleBox["1",
  FontWeight->"Bold"],
 "\n\tt_H2 = 5/37\n\tl = 21*37\n\tdH1 = 4.25e-3*37\n\tdH2 = 1/t_H2 *37\n\n\t\
t_P1 = 20/37\n\tt_P2 = 2/37\n\tdP1 = .1*37\n\tdP2 = 1/t_P2 *37\n\ta = .03*37"
}], "Text",
 CellChangeTimes->{{3.953889353890798*^9, 3.953889385425516*^9}, {
