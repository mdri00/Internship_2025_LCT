\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Effect of maturation variability on the stability properties of the Murdoch 1987 model. Remind that $n = 1/CV_{\text  {maturation time of H1}}^2$. Parameters are $\delta _{H1} = 0, \delta _{P1} = 1, \delta _{P2} = 8, \rho = 33, a = 1, m_P = 1$. \textbf  {(a)} : Local stability diagram of the system around the non-trivial equilibrium. The system is unstable to the left of the curves, and stable to their right.}}{7}{figure.caption.3}\protected@file@percent }
\newlabel{fig:Murdoch}{{3}{7}{Effect of maturation variability on the stability properties of the Murdoch 1987 model. Remind that $n = 1/CV_{\text {maturation time of H1}}^2$. Parameters are $\delta _{H1} = 0, \delta _{P1} = 1, \delta _{P2} = 8, \rho = 33, a = 1, m_P = 1$. \textbf {(a)} : Local stability diagram of the system around the non-trivial equilibrium. The system is unstable to the left of the curves, and stable to their right}{figure.caption.3}{}}
