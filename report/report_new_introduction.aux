\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Sensitivity to developmental variability in Murdoch's model}{9}{}\protected@file@percent }
\newlabel{fig:a}{{3a}{9}{Sensitivity to developmental variability in Murdoch's model}{subfigure.3.1}{}}
\newlabel{sub@fig:a}{{a}{9}{Sensitivity to developmental variability in Murdoch's model}{subfigure.3.1}{}}
\newlabel{fig:b}{{3b}{9}{Sensitivity to developmental variability in Murdoch's model}{subfigure.3.2}{}}
\newlabel{sub@fig:b}{{b}{9}{Sensitivity to developmental variability in Murdoch's model}{subfigure.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Effect of maturation variability on the stability properties of the Murdoch 1987 model. Remind that $n = 1/CV_{\text  {maturation time of H1}}^2$. Parameters are $\delta _{H1} = 0, \delta _{P1} = 1, \delta _{P2} = 8, \rho = 33, a = 1, m_P = 1$. \textbf  {(a)} : Local stability diagram of the system around the non-trivial equilibrium. The system is unstable to the left of the curves, and stable to their right. \textbf  {(b)} : Bifurcation diagram of the system with parameters inspired from those in Wearing 2004 : $\delta _{H1} = 0.00425, \delta _{P1} = 0.1, \delta _{P2} = 0.5, \rho = 105, m_P = 0.05, T_{H2} = 1/\delta _{H2} = 5, T_{H1} = 1/m_H = 37$.}}{9}{}\protected@file@percent }
\newlabel{fig:Murdoch}{{3}{9}{Sensitivity to developmental variability in Murdoch's model}{figure.3}{}}
\newlabel{fig:a}{{4a}{10}{Sensitivity to developmental variability in Murdoch's model}{subfigure.4.1}{}}
\newlabel{sub@fig:a}{{a}{10}{Sensitivity to developmental variability in Murdoch's model}{subfigure.4.1}{}}
\newlabel{fig:b}{{4b}{10}{Sensitivity to developmental variability in Murdoch's model}{subfigure.4.2}{}}
\newlabel{sub@fig:b}{{b}{10}{Sensitivity to developmental variability in Murdoch's model}{subfigure.4.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Effect of maturation variability on the values of the non trivial equilibrium densities in two host-parasitoid models. \textbf  {(a)} : Non trivial equilibrium densities (noted $X^*$ for each stage X) of Murdoch system as a function of the Erlang distribution shapes \textit  {n} and \textit  {m}. See Figure 3 for parameters values. \textbf  {(b)} : Non trivial equilibrium densities (noted $X^*$ for each stage X) of Godfray and Hassel system as a function of $H_2$ and $P_1$ number of subcompartments $n_2 = m$. See Figure 6 for parameters values.}}{10}{}\protected@file@percent }
\newlabel{fig:Eq_densities}{{4}{10}{Sensitivity to developmental variability in Murdoch's model}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Sensitivity to developmental variability in Godfray and Hassel's model}{10}{}\protected@file@percent }
\newlabel{fig:a}{{5a}{11}{Sensitivity to developmental variability in Murdoch's model}{subfigure.5.1}{}}
\newlabel{sub@fig:a}{{a}{11}{Sensitivity to developmental variability in Murdoch's model}{subfigure.5.1}{}}
\newlabel{fig:b}{{5b}{11}{Sensitivity to developmental variability in Murdoch's model}{subfigure.5.2}{}}
\newlabel{sub@fig:b}{{b}{11}{Sensitivity to developmental variability in Murdoch's model}{subfigure.5.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Maturation-variability-dependent effect of host fecundity on the stability properties of the Murdoch 1987 model, given by bifurcation diagrams. In both subfigures, parameters are inspired from those taken in Murdoch 1987 : $m_H = 1/T_{H1} = 1, \delta _{H1} = 0, \delta _{P1} = 1, \delta _{P2} = 8, \rho = 33, a = 1, m_P = 1/T_{P1} = 1$. \textbf  {(a)} : $\delta _{H2} = 1/T_{H2} = 0.15$ . \textbf  {(b)} : $\delta _{H2} = 1/T_{H2} = 1$ .}}{11}{}\protected@file@percent }
\newlabel{fig:Godfray}{{5}{11}{Sensitivity to developmental variability in Murdoch's model}{figure.5}{}}
\newlabel{fig:b}{{6a}{12}{Sensitivity to developmental variability in Godfray and Hassel's model}{subfigure.6.1}{}}
\newlabel{sub@fig:b}{{a}{12}{Sensitivity to developmental variability in Godfray and Hassel's model}{subfigure.6.1}{}}
\newlabel{fig:c}{{6b}{12}{Sensitivity to developmental variability in Godfray and Hassel's model}{subfigure.6.2}{}}
\newlabel{sub@fig:c}{{b}{12}{Sensitivity to developmental variability in Godfray and Hassel's model}{subfigure.6.2}{}}
\newlabel{fig:d}{{6c}{12}{Sensitivity to developmental variability in Godfray and Hassel's model}{subfigure.6.3}{}}
\newlabel{sub@fig:d}{{c}{12}{Sensitivity to developmental variability in Godfray and Hassel's model}{subfigure.6.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Effect of maturation variability on stability properties of the Godfray and Hassel 1989 model. In all subfigures, parameters are inspired from Xu et al. 2010 : $m_{H1} = 1/3, m_{H2} = 1/2, m_{H3} = 1/3, \delta _{H1} = \delta _{H2} = \delta _{H3} = 0, \delta _{H4} = 1, \delta _{P1} = 0, \delta _{P2} = 2.5, r = 15, a = 0.01, k = 1, ratioT = 1, n_1 = 50, n_2 = 50$. \textbf  {(a)} : Local stability boundaries taken from Xu et al. (2010) in the case of fixed delays for all stages. The stability boundaries are plotted with respect to the ratio of parasitoid to host generation times (ratioT) and the search aggregation parameter k. The black curve is associated with the characteristic equation root with large imaginary part. Blue curves are associated with respective characteristic equation roots with small imaginary parts (See text). \textbf  {(b)} : Local stability boundaries for $n_2 = m = 3$ and various values of $(n_1,n_3)$ . For the stability curve on the right, all curves are perfectly superimposed such that only the one for $n_1 = n_3 = 500$ is drawn. \textbf  {(c)} : Local stability boundaries for $n_1 = n_3 = 300$ (except the grey curves taken from Xu et al. 2010 with fixed delays) related to the couples of characteristic roots responsible for the GC area at $ratioT \approx 1.5$. For clarity, the other "U-curves" are not shown here.}}{12}{}\protected@file@percent }
\newlabel{fig:Godfray}{{6}{12}{Sensitivity to developmental variability in Godfray and Hassel's model}{figure.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Comparing the effect of May's implementation of parasitism heterogeneity and the effect of developmental variability}{13}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Effect of the type of parasitism risk heterogeneity on the stability of a 2-stage host-parasitoid system. The number of subcompartiments, or the shape for the Erlang distribution of maturation time is \textit  {n}. May's parasitism clumping parameter (May 1978) is k. One type of risk heterogeneity, either temporal with developmental variability (full lines) or spatial with May's pseudo-interference (dashed lines), was implemented at a time.}}{13}{}\protected@file@percent }
\newlabel{fig:equivalence_k_n}{{7}{13}{Comparing the effect of May's implementation of parasitism heterogeneity and the effect of developmental variability}{figure.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Survey of Erlang/Gamma distribution shape (n)}{13}{}\protected@file@percent }
\newlabel{fig:a}{{8a}{14}{Survey of Erlang/Gamma distribution shape (n)}{subfigure.8.1}{}}
\newlabel{sub@fig:a}{{a}{14}{Survey of Erlang/Gamma distribution shape (n)}{subfigure.8.1}{}}
\newlabel{fig:b}{{8b}{14}{Survey of Erlang/Gamma distribution shape (n)}{subfigure.8.2}{}}
\newlabel{sub@fig:b}{{b}{14}{Survey of Erlang/Gamma distribution shape (n)}{subfigure.8.2}{}}
\newlabel{fig:c}{{8c}{14}{Survey of Erlang/Gamma distribution shape (n)}{subfigure.8.3}{}}
\newlabel{sub@fig:c}{{c}{14}{Survey of Erlang/Gamma distribution shape (n)}{subfigure.8.3}{}}
\newlabel{fig:d}{{8d}{14}{Survey of Erlang/Gamma distribution shape (n)}{subfigure.8.4}{}}
\newlabel{sub@fig:d}{{d}{14}{Survey of Erlang/Gamma distribution shape (n)}{subfigure.8.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Survey of Gamma shape parameter of insects stages found in literature. Only stages like Egg, Larva, Pupa/Nymph and Proto/Deutonymph were retained. In (b), (c), and (d), parameter sets with negative Weibull shifts are excluded. Violin plots use kernel density estimation to compute an empirical distribution of the sample. They were generated using Python library Matplotlib's violinplot function. \textbf  {(a)} and \textbf  {(b)}: Wasserstein distance both between the fitted Gamma and the corresponding Weibull distributions (a) and fitted Gamma shape \textit  {n} (b) respectively. Each grey line connects a couples of species and stage across the fitting constraints. Blue stars indicate the sample median. Red stars indicate the sample mean. \textbf  {(c)} : Fitted Gamma shape as a function of the original Weibull shift, with the constraint that the Gamma shift has to be null. \textbf  {(d)} : Wasserstein distance as a function of the original Weibull shift parameter across the three fitting constraints, with linear regression line estimated with the Ordinary Least Square method. }}{14}{}\protected@file@percent }
\newlabel{fig:Survey}{{8}{14}{Survey of Erlang/Gamma distribution shape (n)}{figure.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Summary statistics of the Weibull-to-Gamma distribution fitting across the three $\tau $ constraints. 62 sets of Weibull parameters were analyzed in total. The 5 sets of parameters with negative shifts are included in the lines about Wasserstein distances, and excluded otherwise. A significant shape change is counted when the fitted shape differs by at least 1 between the 2 given constraints.}}{15}{}\protected@file@percent }
