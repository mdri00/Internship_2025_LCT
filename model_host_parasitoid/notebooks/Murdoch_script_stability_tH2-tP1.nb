            RowBox[{"P2", "[", "t", "]"}]}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"varseq", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"H1eqpredi", "/", "\[Alpha]H"}], ")"}], " ", 
               RowBox[{"sH", "^", 
                RowBox[{"(", 
                 RowBox[{"i", "-", "1"}], ")"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", "nn"}], "}"}]}], "]"}], ",", 
            "H2eqpredi", ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"P1eqpredi", "/", "\[Alpha]P"}], ")"}], " ", 
               RowBox[{"fP", "^", 
                RowBox[{"(", 
                 RowBox[{"i", "-", "1"}], ")"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", "mm"}], "}"}]}], "]"}], ",", " ", 
            "P2eqpredi"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"lJeq", "=", 
         RowBox[{"lJ", " ", "/.", "\[IndentingNewLine]", 
          RowBox[{"Thread", "[", 
           RowBox[{"vars", "->", "varseq"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", "\n", "\t", "\[IndentingNewLine]", 
        RowBox[{"Clear", "[", "VP", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"VP", "[", 
          RowBox[{
           RowBox[{"X_", "?", "NumericQ"}], ",", 
           RowBox[{"Y_", "?", "NumericQ"}]}], "]"}], ":=", 
         RowBox[{"Module", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", "eigs", "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"eigs", "=", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"lJeq", "/.", "paramsplot"}], "/.", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"n", "->", "nn"}], ",", " ", 
                   RowBox[{"m", "->", "mm"}]}], "}"}]}], "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"tH2", "->", "X"}], ",", " ", 
                  RowBox[{"tP1", "->", "Y"}]}], "}"}]}], " ", "//", "N"}], "//",
               " ", "Eigenvalues"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "eigs", "]"}], ">=", 
               RowBox[{"nn", "+", "mm", "+", "2"}]}], ",", 
              RowBox[{
               RowBox[{"eigs", "[", 
                RowBox[{"[", 
                 RowBox[{"nn", "+", "mm", "+", "2"}], "]"}], "]"}], " ", "//",
                " ", "Re"}], ",", "Indeterminate"}], " ", 
             RowBox[{"(*", 
              RowBox[{"Return", " ", "a", " ", "safe", " ", "fallback"}], 
              "*)"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"\[Tau]2Min", "=", "0.01"}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Tau]2Max", "=", "1"}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Tau]2Pas", "=", "0.02"}], ";", "\[IndentingNewLine]", "\t",
         "\[IndentingNewLine]", 
        RowBox[{"CourbeLimite", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"t2", "=", "\[Tau]2Max"}], ",", 
          RowBox[{"t2", ">", "\[Tau]2Min"}], ",", 
          RowBox[{"t2", "-=", "\[Tau]2Pas"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", "tsol", "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"\"\<t2 = \>\"", ",", "t2"}], "]"}], ";"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"tsol", "=", 
              RowBox[{"Check", "[", 
               RowBox[{
                RowBox[{"ta", "/.", " ", 
                 RowBox[{"FindRoot", "[", 
                  RowBox[{
                   RowBox[{"VP", "[", 
                    RowBox[{"ta", ",", "t2"}], "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"ta", ",", "0.01", ",", "5"}], "}"}], ",", 
                   RowBox[{"Method", "->", "\"\<Brent\>\""}]}], "]"}]}], ",", 
                "\"\<Failed\>\""}], "]"}]}], ";", " ", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{
               "Use", " ", "Quiet", " ", "to", " ", "suppress", " ", 
                "warnings"}], ",", 
               RowBox[{"Check", " ", "to", " ", "handle", " ", "failures"}]}],
               "*)"}], "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"NumericQ", "[", "tsol", "]"}], "&&", 
                RowBox[{"tsol", ">", "0"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"CourbeLimite", ",", 
                 RowBox[{"{", 
                  RowBox[{"tsol", ",", "t2"}], "}"}]}], "]"}]}], 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"Print", "[", 
                RowBox[{
                "\"\<Skipping t2 = \>\"", ",", "t2", ",", 
                 "\"\< (FindRoot failed)\>\""}], "]"}], "*)"}], "]"}]}]}], 
           "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"StabilityCurveData", ",", " ", "CourbeLimite"}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", 
     RowBox[{"Length", "[", "nmValues", "]"}]}], "}"}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
