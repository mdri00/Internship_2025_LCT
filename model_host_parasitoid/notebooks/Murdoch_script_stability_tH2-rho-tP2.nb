    RowBox[{"(", 
     RowBox[{"\[Theta]P", " ", "+", " ", "\[Delta]P1"}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"P2eqpredi", " ", "=", " ", 
